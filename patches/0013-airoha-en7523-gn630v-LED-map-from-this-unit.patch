From 7b56790a8a26b30575e4e3b4c9781a962f4e254a Mon Sep 17 00:00:00 2001
From: idiazraz <100824525+idiazraz@users.noreply.github.com>
Date: Sun, 25 Oct 2026 13:16:36 +0800
Subject: [PATCH 13/13] airoha: en7523: gn630v: LED map from this unit

---
 .../airoha/dts/en7523-skyworth-gn630v.dts     | 35 +++++++++++++------
 1 file changed, 25 insertions(+), 10 deletions(-)

diff --git a/target/linux/airoha/dts/en7523-skyworth-gn630v.dts b/target/linux/airoha/dts/en7523-skyworth-gn630v.dts
index 680741e55a..849bcd35ea 100644
--- a/target/linux/airoha/dts/en7523-skyworth-gn630v.dts
+++ b/target/linux/airoha/dts/en7523-skyworth-gn630v.dts
@@ -41,12 +41,12 @@
 	};
 
 	/*
-	 * LED GPIOs from the stock kernel cmdline: power_gpio=0b, dsl_gpio=0a (PON),
-	 * internet_gpio=01, active low; gpio_active_high marks GPIO2-5 active high.
-	 * USB (2) and phone (3) were found by blinking them on this unit. LAN LEDs
-	 * (GPIO22-25) are the MT7530 PHYs' LED0 outputs; GPIO4-7, which the SoC
-	 * dtsi gives the PHYs as LED1, are board LEDs here (the stock table puts
-	 * Wi-Fi on 6 and WPS on 26) and are left free until each is identified.
+	 * LEDs as found by blinking each pin on this unit (2026-10-25); the
+	 * stock U-Boot env (dsl_gpio=0a) and vendor LED table do not match this
+	 * board's wiring, and neither does env gpio_active_high: the polarities
+	 * below were confirmed on the panel too. LAN LEDs (GPIO22-25) are the MT7530 PHYs' LED0
+	 * outputs. GPIO5 is not a panel LED (it disturbed LAN4's LED). The Wi-Fi
+	 * LED is not found yet.
 	 */
 	leds {
 		compatible = "gpio-leds";
@@ -59,7 +59,12 @@
 
 		led-pon {
 			label = "green:pon";
-			gpios = <&pinctrl 10 GPIO_ACTIVE_LOW>;
+			gpios = <&pinctrl 6 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-los {
+			label = "red:los";
+			gpios = <&pinctrl 10 GPIO_ACTIVE_HIGH>;
 		};
 
 		led-internet {
@@ -72,9 +77,19 @@
 			gpios = <&pinctrl 2 GPIO_ACTIVE_HIGH>;
 		};
 
-		led-phone {
-			label = "green:phone";
-			gpios = <&pinctrl 3 GPIO_ACTIVE_HIGH>;
+		led-voip {
+			label = "green:voip";
+			gpios = <&pinctrl 3 GPIO_ACTIVE_LOW>;
+		};
+
+		led-tel {
+			label = "green:tel";
+			gpios = <&pinctrl 4 GPIO_ACTIVE_LOW>;
+		};
+
+		led-wps {
+			label = "green:wps";
+			gpios = <&pinctrl 26 GPIO_ACTIVE_LOW>;
 		};
 	};
 
