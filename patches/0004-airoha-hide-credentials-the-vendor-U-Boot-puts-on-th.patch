From b0f9c1abbed918236f39a32615754ef0429935c1 Mon Sep 17 00:00:00 2001
From: idiazraz <100824525+idiazraz@users.noreply.github.com>
Date: Sat, 24 Oct 2026 19:42:49 +0800
Subject: [PATCH] airoha: hide credentials the vendor U-Boot puts on the
 command line

The GN630V's U-Boot passes its whole environment as kernel parameters, including the stock web UI login. Blank the username and password values before they reach the kernel log, /proc/cmdline, init's environment or the device tree copy.
---
 ...hide-credentials-on-the-command-line.patch | 96 +++++++++++++++++++
 1 file changed, 96 insertions(+)
 create mode 100644 target/linux/airoha/patches-6.18/990-init-hide-credentials-on-the-command-line.patch

diff --git a/target/linux/airoha/patches-6.18/990-init-hide-credentials-on-the-command-line.patch b/target/linux/airoha/patches-6.18/990-init-hide-credentials-on-the-command-line.patch
new file mode 100644
index 0000000000..36ea160225
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/990-init-hide-credentials-on-the-command-line.patch
@@ -0,0 +1,96 @@
+From: idiazraz <100824525+idiazraz@users.noreply.github.com>
+Subject: [PATCH] init: hide credentials a vendor bootloader puts on the command line
+
+The EcoNet/Airoha U-Boot on ISP ONTs passes its whole environment as
+kernel parameters, including the stock web UI username and password.
+Blank those values before the command line is logged, saved for
+/proc/cmdline or passed to init as environment, and in the device tree
+copy of bootargs.
+
+---
+--- a/init/main.c
++++ b/init/main.c
+@@ -52,6 +52,7 @@
+ #include <linux/cpu.h>
+ #include <linux/cpuset.h>
+ #include <linux/memcontrol.h>
++#include <linux/of.h>
+ #include <linux/cgroup.h>
+ #include <linux/tick.h>
+ #include <linux/sched/isolation.h>
+@@ -620,6 +621,66 @@
+ #endif
+ 
+ /*
++ * Some vendor bootloaders (EcoNet/Airoha U-Boot on ISP ONTs) pass their
++ * whole environment on the command line, including the stock web UI login.
++ * Blank the values of these parameters before the command line is logged,
++ * saved for /proc/cmdline or turned into init's environment.
++ */
++static const char *const hidden_bootargs[] __initconst = {
++	"username=", "password=",
++};
++
++static void __init hide_bootarg_values(char *s, size_t len)
++{
++	size_t i, k, n;
++
++	for (i = 0; i < len && s[i]; i++) {
++		if (i && s[i - 1] != ' ')
++			continue;
++		for (k = 0; k < ARRAY_SIZE(hidden_bootargs); k++) {
++			n = strlen(hidden_bootargs[k]);
++			if (strncmp(s + i, hidden_bootargs[k], n))
++				continue;
++			for (i += n; i < len && s[i] && s[i] != ' '; i++)
++				s[i] = 'x';
++			break;
++		}
++	}
++}
++
++/*
++ * The copy in the device tree (/proc/device-tree/chosen/bootargs). Its value
++ * lives in the flattened tree, which is mapped read-only: replace the
++ * property with a blanked copy instead of writing to it.
++ */
++static int __init hide_dt_bootarg_values(void)
++{
++	struct property *old, *new;
++
++	old = of_chosen ? of_find_property(of_chosen, "bootargs", NULL) : NULL;
++	if (!old || !old->value || !old->length)
++		return 0;
++
++	new = kzalloc(sizeof(*new), GFP_KERNEL);
++	if (!new)
++		return 0;
++	new->name = kstrdup(old->name, GFP_KERNEL);
++	new->value = kmemdup(old->value, old->length, GFP_KERNEL);
++	new->length = old->length;
++	if (!new->name || !new->value) {
++		kfree(new->name);
++		kfree(new->value);
++		kfree(new);
++		return 0;
++	}
++
++	hide_bootarg_values(new->value, new->length);
++	of_update_property(of_chosen, new);
++	return 0;
++}
++late_initcall(hide_dt_bootarg_values);
++
++/*
+  * We need to store the untouched command line for future reference.
+  * We also need to store the touched command line since the parameter
+  * parsing is performed in place, and we should allow a component to
+@@ -918,6 +979,8 @@
+ 	static_call_init();
+ 	early_security_init();
+ 	mangle_bootargs(command_line);
++	hide_bootarg_values(boot_command_line, COMMAND_LINE_SIZE);
++	hide_bootarg_values(command_line, strlen(command_line));
+ 	setup_boot_config();
+ 	setup_command_line(command_line);
+ 	setup_nr_cpu_ids();
