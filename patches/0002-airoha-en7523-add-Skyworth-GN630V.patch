diff --git a/target/linux/airoha/dts/en7523-skyworth-gn630v.dts b/target/linux/airoha/dts/en7523-skyworth-gn630v.dts
new file mode 100644
index 0000000000..a5a59c6957
--- /dev/null
+++ b/target/linux/airoha/dts/en7523-skyworth-gn630v.dts
@@ -0,0 +1,436 @@
+// SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+/dts-v1/;
+
+/*
+ * Skyworth GN630V: GPON ONT, AX3000, 4x GbE.
+ * Airoha AN7529CT (EN7523 family, 2x Cortex-A53 in AArch32), 512 MB DDR,
+ * 256 MiB FORESEE F35SQB002G SPI-NAND, MT7916 Wi-Fi on PCIe.
+ * Derived from en7523-ax3000-router.dts. Facts from the stock UART boot log
+ * (stock kernel 4.4.115, U-Boot 2014.04 Skyworth build).
+ */
+/memreserve/ 0x80000000 0x200000;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/reset/airoha,en7523-reset.h>
+#include "en7523.dtsi"
+
+/ {
+	model = "Skyworth GN630V";
+	compatible = "skyworth,gn630v", "airoha,en7523";
+
+	aliases {
+		serial0 = &uart1;
+	};
+
+	chosen {
+		bootargs = "console=ttyS0,115200 earlycon";
+		/* root= comes from the vendor U-Boot: /dev/mtdblock3 when it boots
+		 * bank A, /dev/mtdblock6 for bank B (see the partition order) */
+		bootargs-append = " rootfstype=squashfs";
+		stdout-path = "serial0:115200n8";
+		linux,usable-memory-range = <0x80200000 0x1fe00000>;
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x80000000 0x20000000>;
+	};
+
+	reserved-memory {
+		qdma0_buf: qdma0-buf@87000000 {
+			no-map;
+			reg = <0x87000000 0x02000000>;
+		};
+
+		qdma1_buf: qdma1-buf@89000000 {
+			no-map;
+			reg = <0x89000000 0x01000000>;
+		};
+	};
+
+	npu: npu@1e800000 {
+		compatible = "econet,ecnt-npu";
+		reg = <0x1e800000 0x60000>, <0x1e900000 0x313000>;
+		memory-region = <&{/reserved-memory/npu_binary@84000000}>;
+		clocks = <&scu EN7523_CLK_NPU>;
+		clock-names = "npu";
+		resets = <&scu EN7523_NPU_RST>;
+		reset-names = "npu";
+		interrupts = <0x00 0x76 0x04>, <0x00 0x77 0x04>,
+			     <0x00 0x78 0x04>, <0x00 0x79 0x04>,
+			     <0x00 0x7a 0x04>, <0x00 0x7b 0x04>,
+			     <0x00 0x7d 0x04>;
+	};
+
+	/*
+	 * LED GPIOs from the stock kernel cmdline: power_gpio=0b, dsl_gpio=0a (PON),
+	 * internet_gpio=01. Same pins as the EN7523 AX3000 board; polarity taken
+	 * from there and not yet verified on the GN630V. LAN LEDs (GPIO22-25, in
+	 * multi_upgrade_gpio) are MT7530 PHY LED outputs. LOS/Wi-Fi/WPS LEDs and
+	 * the buttons are left out until their GPIOs are identified: a wrong
+	 * reset-button GPIO could trigger reboots.
+	 */
+	leds {
+		compatible = "gpio-leds";
+
+		led-power {
+			label = "green:power";
+			gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;
+			default-state = "on";
+		};
+
+		led-pon {
+			label = "green:pon";
+			gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
+		};
+
+		led-internet {
+			label = "green:internet";
+			gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	/*
+	 * Ethernet and switch nodes. Initially disabled here; enabled via
+	 * status="okay" references at the bottom of this file.
+	 */
+	eth: ethernet@1fb50000 {
+		compatible = "airoha,en7523-eth";
+		status = "disabled";
+
+		reg = <0x1fb50000 0x2600>,
+		      <0x1fb54000 0x2000>,
+		      <0x1fb56000 0x2000>,
+		      <0x1fbf9000 0x1000>;
+		reg-names = "fe", "qdma0", "qdma1", "gdmp";
+
+		resets = <&scu EN7523_FE_RST>,
+			 <&scu EN7523_FE_PDMA_RST>,
+			 <&scu EN7523_FE_QDMA_RST>,
+			 <&scu EN7523_DUAL_HSI0_MAC_RST>,
+			 <&scu EN7523_DUAL_HSI1_MAC_RST>,
+			 <&scu EN7523_HSI_MAC_RST>,
+			 <&scu EN7523_GDMP_RST>;
+		reset-names = "fe", "pdma", "qdma",
+			      "hsi0-mac", "hsi1-mac", "hsi-mac", "gdmp";
+
+		interrupts = <GIC_SPI 37 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 55 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 56 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 57 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 38 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 58 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 59 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 60 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 49 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH>;
+
+		memory-region = <&qdma0_buf>, <&qdma1_buf>;
+		memory-region-names = "qdma0-buf", "qdma1-buf";
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		gdm1: ethernet@1 {
+			compatible = "airoha,eth-mac";
+			reg = <1>;
+			phy-mode = "internal";
+			status = "disabled";
+
+			nvmem-cells = <&macaddr_uboot 0>;
+			nvmem-cell-names = "mac-address";
+
+			fixed-link {
+				speed = <10000>;
+				full-duplex;
+				pause;
+			};
+		};
+	};
+
+	switch: switch@1fb58000 {
+		compatible = "airoha,en7523-switch";
+		reg = <0x1fb58000 0x8000>;
+		resets = <&scu EN7523_GSW_RST>;
+		interrupt-controller;
+		#interrupt-cells = <1>;
+		interrupt-parent = <&gic>;
+		interrupts = <GIC_SPI 31 IRQ_TYPE_LEVEL_HIGH>;
+		status = "disabled";
+
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			gsw_port1: port@1 {
+				reg = <1>;
+				phy-mode = "internal";
+				phy-handle = <&gsw_phy1>;
+				status = "disabled";
+			};
+
+			gsw_port2: port@2 {
+				reg = <2>;
+				phy-mode = "internal";
+				phy-handle = <&gsw_phy2>;
+				status = "disabled";
+			};
+
+			gsw_port3: port@3 {
+				reg = <3>;
+				phy-mode = "internal";
+				phy-handle = <&gsw_phy3>;
+				status = "disabled";
+			};
+
+			gsw_port4: port@4 {
+				reg = <4>;
+				phy-mode = "internal";
+				phy-handle = <&gsw_phy4>;
+				status = "disabled";
+			};
+
+			port@6 {
+				reg = <6>;
+				ethernet = <&gdm1>;
+				phy-mode = "internal";
+
+				fixed-link {
+					speed = <10000>;
+					full-duplex;
+					pause;
+				};
+			};
+		};
+
+		mdio: mdio {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			gsw_phy1: ethernet-phy@9 {
+				compatible = "ethernet-phy-ieee802.3-c22";
+				reg = <9>;
+			};
+
+			gsw_phy2: ethernet-phy@a {
+				compatible = "ethernet-phy-ieee802.3-c22";
+				reg = <10>;
+			};
+
+			gsw_phy3: ethernet-phy@b {
+				compatible = "ethernet-phy-ieee802.3-c22";
+				reg = <11>;
+			};
+
+			gsw_phy4: ethernet-phy@c {
+				compatible = "ethernet-phy-ieee802.3-c22";
+				reg = <12>;
+			};
+		};
+	};
+};
+
+&gpio0 {
+	status = "okay";
+};
+
+&gpio1 {
+	status = "okay";
+};
+
+&pcie0 {
+	status = "okay";
+};
+
+&pcie1 {
+	status = "okay";
+
+	pcie@1,0 {
+		reg = <0x0800 0 0 0 0>;
+		#address-cells = <3>;
+		#size-cells = <2>;
+
+		wifi: wifi@0,0 {
+			compatible = "mediatek,mt76";
+			reg = <0x0000 0 0 0 0>;
+
+			airoha,npu = <&npu>;
+			airoha,eth = <&eth>;
+
+			nvmem-cells = <&mt7916_eeprom_factory>, <&macaddr_uboot 4>;
+			nvmem-cell-names = "eeprom", "mac-address";
+
+			led {
+				led-sources = <2>;
+				led-active-low;
+			};
+		};
+	};
+};
+
+&nand {
+	status = "okay";
+
+	partitions {
+		compatible = "fixed-partitions";
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		/*
+		 * Dual image. The U-Boot bootflag (ASCII '0'/'1' at 0xdfc0000) selects
+		 * bank A (0xc0000) or bank B (0x20c0000), 32 MiB each. AlphaWRT runs from
+		 * either bank: the stock web upgrade writes the inactive one. Each bank:
+		 *   +0      HDR2 header + FIT (fdt@1/kernel@1/filesystem@1), 6 MiB
+		 *   +6 MiB  squashfs root, 16 MiB
+		 *   +22 MiB UBI overlay (rootfs_data), 10 MiB
+		 * The partition order is fixed so that the root= the vendor U-Boot passes
+		 * (mtdblock3 for A, mtdblock6 for B) is the right squashfs. Software only
+		 * writes the bank it runs from; the other bank keeps stock as fallback.
+		 * 0x6dc0000-0xddc0000 is unused (verified erased).
+		 */
+		partition@0 {
+			label = "bootloader";
+			reg = <0x00000000 0x00080000>;
+			read-only;
+
+			/* U-Boot env at 0x7c000 (16 KiB, CRC32 + key=value). Never write it:
+			 * it shares an erase block with U-Boot code. */
+			nvmem-layout {
+				compatible = "fixed-layout";
+				#address-cells = <1>;
+				#size-cells = <1>;
+
+				/* value of "ethaddr=" in the env, "xx:xx:xx:xx:xx:xx" */
+				macaddr_uboot: macaddr@7c34e {
+					compatible = "mac-base";
+					reg = <0x7c34e 0x11>;
+					#nvmem-cell-cells = <1>;
+				};
+			};
+		};
+
+		partition@80000 {
+			label = "romfile";
+			reg = <0x00080000 0x00040000>;
+			read-only;
+		};
+
+		/* bank A (stock "tclinux") */
+		partition@c0000 {
+			label = "kernel";
+			reg = <0x000c0000 0x00600000>;
+		};
+
+		partition@6c0000 {
+			label = "alphawrt_rootfs";	/* mtd3 */
+			reg = <0x006c0000 0x01000000>;
+		};
+
+		partition@16c0000 {
+			/* not "ubi"/"data", so no UBI auto-attach: preinit attaches the
+			 * data partition of the bank it booted from */
+			label = "alphawrt_data";
+			reg = <0x016c0000 0x00a00000>;
+		};
+
+		/* bank B (stock "tclinux_slave") */
+		partition@20c0000 {
+			label = "kernel_b";
+			reg = <0x020c0000 0x00600000>;
+		};
+
+		partition@26c0000 {
+			label = "alphawrt_rootfs_b";	/* mtd6 */
+			reg = <0x026c0000 0x01000000>;
+		};
+
+		partition@36c0000 {
+			label = "alphawrt_data_b";
+			reg = <0x036c0000 0x00a00000>;
+		};
+
+		partition@40c0000 {
+			label = "config";
+			reg = <0x040c0000 0x00800000>;
+			read-only;
+		};
+
+		partition@48c0000 {
+			label = "ubifs";
+			reg = <0x048c0000 0x02000000>;
+			read-only;
+		};
+
+		partition@68c0000 {
+			label = "teapot";
+			reg = <0x068c0000 0x00500000>;
+			read-only;
+		};
+
+		partition@ddc0000 {
+			label = "reservearea";
+			reg = <0x0ddc0000 0x00200000>;
+			read-only;
+
+			nvmem-layout {
+				compatible = "fixed-layout";
+				#address-cells = <1>;
+				#size-cells = <1>;
+
+				/*
+				 * Stock reads Wi-Fi calibration from reservearea 0x33000 ("2.4G")
+				 * and 0x4c000 ("5G"). The AX3000 board's MT7916 EEPROM is at
+				 * 0x4c000; verify against a reservearea dump.
+				 */
+				mt7916_eeprom_factory: eeprom@4c000 {
+					reg = <0x4c000 0x1000>;
+				};
+			};
+		};
+
+		/* the stock reservearea continues here: its 128 KiB block holding
+		 * only the U-Boot bootflag (see alphawrt-bootbank) */
+		partition@dfc0000 {
+			label = "bootflag";
+			reg = <0x0dfc0000 0x00020000>;
+		};
+
+		partition@dfe0000 {
+			label = "reservearea_tail";
+			reg = <0x0dfe0000 0x00020000>;
+			read-only;
+		};
+	};
+};
+
+&eth {
+	status = "okay";
+};
+
+&gdm1 {
+	status = "okay";
+};
+
+&switch {
+	status = "okay";
+};
+
+&gsw_port1 {
+	status = "okay";
+};
+
+&gsw_port2 {
+	status = "okay";
+};
+
+&gsw_port3 {
+	status = "okay";
+};
+
+&gsw_port4 {
+	status = "okay";
+};
