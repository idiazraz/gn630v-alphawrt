diff --git a/target/linux/airoha/patches-6.18/205-mtd-spinand-add-Foresee-F35SQB002G-flash-support.patch b/target/linux/airoha/patches-6.18/205-mtd-spinand-add-Foresee-F35SQB002G-flash-support.patch
