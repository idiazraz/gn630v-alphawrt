From 42ff1a6dbb27fabc6b7b77beabbff900220722cf Mon Sep 17 00:00:00 2001
From: idiazraz <100824525+idiazraz@users.noreply.github.com>
Date: Sat, 24 Oct 2026 11:51:40 +0800
Subject: [PATCH] airoha: en7523: add Skyworth GN630V

GPON ONT, AX3000: Airoha AN7529CT (EN7523), 512 MB, 256 MiB FORESEE
F35SQB002G SPI-NAND, MT7916 on PCIe (main + hif2), EN7571 optics.

- runs from either vendor U-Boot bank (HDR2 + FIT image, also accepted
  by the stock web upgrade), stock kept in the other bank; UBI overlay
  per bank; bank-aware sysupgrade; alphawrt-bootbank
- MACs from the U-Boot env, MT7916 and EN7571 calibration from flash
- xPON: EN7571 with the unit's own BOB, xPON PHY/MAC, pon0; the GPON
  identity is left to the OMCI agent configuration
- Wi-Fi defaults from the stock configuration, encrypted DNS by default
- no NPU firmware; PCIe reset pinctrl dropped (the pinctrl driver
  rejects it and both controllers then fail to probe)
---
 .../airoha/dts/en7523-skyworth-gn630v.dts     | 342 ++++++++++++++++++
 .../en7523/base-files/etc/board.d/01_leds     |   3 +
 .../en7523/base-files/etc/board.d/02_network  |   1 +
 .../en7523/base-files/lib/upgrade/platform.sh |  41 +++
 target/linux/airoha/image/en7523.mk           |  42 +++
 5 files changed, 429 insertions(+)
 create mode 100644 target/linux/airoha/dts/en7523-skyworth-gn630v.dts

diff --git a/target/linux/airoha/dts/en7523-skyworth-gn630v.dts b/target/linux/airoha/dts/en7523-skyworth-gn630v.dts
new file mode 100644
index 0000000000..f1d9c4799d
--- /dev/null
+++ b/target/linux/airoha/dts/en7523-skyworth-gn630v.dts
@@ -0,0 +1,342 @@
+// SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+/dts-v1/;
+
+/*
+ * Skyworth GN630V: GPON ONT, AX3000, 4x GbE.
+ * Airoha AN7529CT (EN7523 family, 2x Cortex-A53 in AArch32), 512 MB DDR,
+ * 256 MiB FORESEE F35SQB002G SPI-NAND, MT7916 Wi-Fi on PCIe, EN7571 GPON
+ * optics. Facts from the stock UART boot log (stock kernel 4.4.115, U-Boot
+ * 2014.04 Skyworth build) and the stock flash.
+ */
+/memreserve/ 0x80000000 0x200000;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include "en7523.dtsi"
+
+/ {
+	model = "Skyworth GN630V";
+	compatible = "skyworth,gn630v", "airoha,en7523";
+
+	aliases {
+		serial0 = &uart1;
+		led-boot = &led_power;
+		led-failsafe = &led_power;
+		led-upgrade = &led_power;
+		led-running = &led_power;
+	};
+
+	chosen {
+		bootargs = "console=ttyS0,115200 earlycon";
+		/* root= comes from the vendor U-Boot: /dev/mtdblock3 when it boots
+		 * bank A, /dev/mtdblock6 for bank B (see the partition order) */
+		bootargs-append = " rootfstype=squashfs";
+		stdout-path = "serial0:115200n8";
+		linux,usable-memory-range = <0x80200000 0x1fe00000>;
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x80000000 0x20000000>;
+	};
+
+	/*
+	 * LED GPIOs from the stock kernel cmdline: power_gpio=0b, dsl_gpio=0a (PON),
+	 * internet_gpio=01, active low. LAN LEDs (GPIO22-25, in
+	 * multi_upgrade_gpio) are MT7530 PHY LED outputs. LOS/Wi-Fi/WPS LEDs and
+	 * the buttons are left out until their GPIOs are identified: a wrong
+	 * reset-button GPIO could trigger reboots.
+	 */
+	leds {
+		compatible = "gpio-leds";
+
+		led_power: led-power {
+			label = "green:power";
+			gpios = <&pinctrl 11 GPIO_ACTIVE_LOW>;
+			default-state = "on";
+		};
+
+		led-pon {
+			label = "green:pon";
+			gpios = <&pinctrl 10 GPIO_ACTIVE_LOW>;
+		};
+
+		led-internet {
+			label = "green:internet";
+			gpios = <&pinctrl 1 GPIO_ACTIVE_LOW>;
+		};
+	};
+};
+
+&spi0 {
+	flash@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			/*
+			 * Dual image. The U-Boot bootflag (ASCII '0'/'1' at 0xdfc0000)
+			 * selects bank A (0xc0000) or bank B (0x20c0000), 32 MiB each.
+			 * AlphaWRT runs from either bank: the stock web upgrade writes the
+			 * inactive one. Each bank:
+			 *   +0      HDR2 header + FIT (fdt@1/kernel@1/filesystem@1), 6 MiB
+			 *   +6 MiB  squashfs root, 16 MiB
+			 *   +22 MiB UBI overlay (rootfs_data), 10 MiB
+			 * The partition order is fixed so that the root= the vendor U-Boot
+			 * passes (mtdblock3 for A, mtdblock6 for B) is the right squashfs.
+			 * Software only writes the bank it runs from; the other bank keeps
+			 * stock as fallback. 0x6dc0000-0xddc0000 is unused (verified erased).
+			 */
+			partition@0 {
+				label = "bootloader";
+				reg = <0x00000000 0x00080000>;
+				read-only;
+
+				/* U-Boot env at 0x7c000 (16 KiB, CRC32 + key=value). Never
+				 * write it: it shares an erase block with U-Boot code. */
+				nvmem-layout {
+					compatible = "fixed-layout";
+					#address-cells = <1>;
+					#size-cells = <1>;
+
+					/* value of "ethaddr=" in the env, "xx:xx:xx:xx:xx:xx" */
+					macaddr_uboot: macaddr@7c34e {
+						compatible = "mac-base";
+						reg = <0x7c34e 0x11>;
+						#nvmem-cell-cells = <1>;
+					};
+				};
+			};
+
+			partition@80000 {
+				label = "romfile";
+				reg = <0x00080000 0x00040000>;
+				read-only;
+			};
+
+			/* bank A (stock "tclinux") */
+			partition@c0000 {
+				label = "kernel";
+				reg = <0x000c0000 0x00600000>;
+			};
+
+			partition@6c0000 {
+				label = "alphawrt_rootfs";	/* mtd3 */
+				reg = <0x006c0000 0x01000000>;
+			};
+
+			partition@16c0000 {
+				/* not "ubi"/"data", so no UBI auto-attach: preinit attaches
+				 * the data partition of the bank it booted from */
+				label = "alphawrt_data";
+				reg = <0x016c0000 0x00a00000>;
+			};
+
+			/* bank B (stock "tclinux_slave") */
+			partition@20c0000 {
+				label = "kernel_b";
+				reg = <0x020c0000 0x00600000>;
+			};
+
+			partition@26c0000 {
+				label = "alphawrt_rootfs_b";	/* mtd6 */
+				reg = <0x026c0000 0x01000000>;
+			};
+
+			partition@36c0000 {
+				label = "alphawrt_data_b";
+				reg = <0x036c0000 0x00a00000>;
+			};
+
+			partition@40c0000 {
+				label = "config";
+				reg = <0x040c0000 0x00800000>;
+				read-only;
+			};
+
+			partition@48c0000 {
+				label = "ubifs";
+				reg = <0x048c0000 0x02000000>;
+				read-only;
+			};
+
+			partition@68c0000 {
+				label = "teapot";
+				reg = <0x068c0000 0x00500000>;
+				read-only;
+			};
+
+			partition@ddc0000 {
+				label = "reservearea";
+				reg = <0x0ddc0000 0x00200000>;
+				read-only;
+
+				nvmem-layout {
+					compatible = "fixed-layout";
+					#address-cells = <1>;
+					#size-cells = <1>;
+
+					/* MT7916 calibration, as stock ("5G" at 0x4c000) */
+					mt7916_eeprom_factory: eeprom@4c000 {
+						reg = <0x4c000 0x1000>;
+					};
+
+					/* EN7571 laser calibration (BOB): magic 0x07050701
+					 * at +0x94 */
+					en7571_bob: bob@140477 {
+						reg = <0x140477 0x200>;
+					};
+				};
+			};
+
+			/* the stock reservearea continues here: its 128 KiB block
+			 * holding only the U-Boot bootflag (see alphawrt-bootbank) */
+			partition@dfc0000 {
+				label = "bootflag";
+				reg = <0x0dfc0000 0x00020000>;
+			};
+
+			partition@dfe0000 {
+				label = "reservearea_tail";
+				reg = <0x0dfe0000 0x00020000>;
+				read-only;
+			};
+		};
+	};
+};
+
+/*
+ * The EN7523 pinctrl rejects the dtsi's open-drain setting on the PCIe reset
+ * pins ("pin_config_set op failed for pin 41"), which stops both PCIe
+ * controllers from probing. The reset works without it, as on the stock
+ * kernel.
+ */
+&pcie0 {
+	status = "okay";
+
+	/delete-property/ pinctrl-names;
+	/delete-property/ pinctrl-0;
+};
+
+&pcie1 {
+	status = "okay";
+
+	/delete-property/ pinctrl-names;
+	/delete-property/ pinctrl-0;
+
+	pcie@1,0 {
+		reg = <0x0800 0 0 0 0>;
+		#address-cells = <3>;
+		#size-cells = <2>;
+
+		wifi: wifi@0,0 {
+			compatible = "mediatek,mt76";
+			reg = <0x0000 0 0 0 0>;
+
+			nvmem-cells = <&mt7916_eeprom_factory>, <&macaddr_uboot 4>;
+			nvmem-cell-names = "eeprom", "mac-address";
+
+			led {
+				led-sources = <2>;
+				led-active-low;
+			};
+		};
+	};
+};
+
+&i2c0 {
+	status = "okay";
+
+	en7571: lddla@70 {
+		compatible = "airoha,en7571";
+		reg = <0x70>;
+
+		nvmem-cells = <&en7571_bob>;
+		nvmem-cell-names = "calibration";
+
+		#optical-frontend-cells = <0>;
+	};
+};
+
+&xpon_phy {
+	status = "okay";
+};
+
+/* GPON identity is not set here: it is the ISP's, and goes in the OMCI
+ * agent configuration (quick setup). */
+&xpon {
+	status = "okay";
+	omci-vendor-id = "SKYW";
+
+	optical-frontends = <&en7571>;
+	optical-frontend-names = "pon";
+};
+
+&eth {
+	status = "okay";
+};
+
+&gdm1 {
+	status = "okay";
+
+	nvmem-cells = <&macaddr_uboot 0>;
+	nvmem-cell-names = "mac-address";
+};
+
+&gdm2 {
+	status = "okay";
+	phy-mode = "internal";
+
+	nvmem-cells = <&macaddr_uboot 1>;
+	nvmem-cell-names = "mac-address";
+
+	/delete-property/ pcs-handle;
+
+	airoha,xpon-managed;
+	openwrt,netdev-name = "pon0";
+};
+
+&switch {
+	status = "okay";
+};
+
+&gsw_port1 {
+	label = "lan1";
+	status = "okay";
+};
+
+&gsw_port2 {
+	label = "lan2";
+	status = "okay";
+};
+
+&gsw_port3 {
+	label = "lan3";
+	status = "okay";
+};
+
+&gsw_port4 {
+	label = "lan4";
+	status = "okay";
+};
+
+&gsw_phy1 {
+	status = "okay";
+};
+
+&gsw_phy2 {
+	status = "okay";
+};
+
+&gsw_phy3 {
+	status = "okay";
+};
+
+&gsw_phy4 {
+	status = "okay";
+};
diff --git a/target/linux/airoha/en7523/base-files/etc/board.d/01_leds b/target/linux/airoha/en7523/base-files/etc/board.d/01_leds
index 92bca967f7..c4e3528693 100644
--- a/target/linux/airoha/en7523/base-files/etc/board.d/01_leds
+++ b/target/linux/airoha/en7523/base-files/etc/board.d/01_leds
@@ -59,6 +59,9 @@ case "$board" in
     ucidef_set_led_usbdev "usb" "usb" "blue:usb-4" "1-1"
     ucidef_set_led_default "wan_err" "wan_err" "red:wan-10" "default-off"
     ;;
+  skyworth,gn630v)
+    ucidef_set_led_default "power" "power" "green:power" "1"
+    ;;
   tplink,xx230v-v1)
     ucidef_set_led_netdev "lan1" "lan1" "mt7530-0:09:green:lan" "lan1" "link tx rx"
     ucidef_set_led_netdev "lan2" "lan2" "mt7530-0:0a:green:lan" "lan2" "link tx rx"
diff --git a/target/linux/airoha/en7523/base-files/etc/board.d/02_network b/target/linux/airoha/en7523/base-files/etc/board.d/02_network
index e416cce26f..45f5b910e1 100644
--- a/target/linux/airoha/en7523/base-files/etc/board.d/02_network
+++ b/target/linux/airoha/en7523/base-files/etc/board.d/02_network
@@ -40,6 +40,7 @@ setup_interfaces()
     ;;
   askey,rtf8225vw | \
   mitrastar,gpt-2742gx4x5v6 | \
+  skyworth,gn630v | \
   tplink,xx230v-v1)
     ucidef_set_interface_lan "lan1 lan2 lan3 lan4"
     ;;
diff --git a/target/linux/airoha/en7523/base-files/lib/upgrade/platform.sh b/target/linux/airoha/en7523/base-files/lib/upgrade/platform.sh
index 7b4db5ec4c..a668ee31de 100644
--- a/target/linux/airoha/en7523/base-files/lib/upgrade/platform.sh
+++ b/target/linux/airoha/en7523/base-files/lib/upgrade/platform.sh
@@ -70,10 +70,47 @@ platform_do_upgrade_mikrotik_nand() {
 	nand_do_upgrade "$image"
 }
 
+# Skyworth GN630V: each flash bank holds HDR2 + FIT padded to 6 MiB, then
+# squashfs, then the UBI overlay. Helpers in /lib/upgrade/alphawrt.sh.
+gn630v_check_image() {
+	[ "$(dd if="$1" bs=4 count=1 2>/dev/null)" = "HDR2" ] || {
+		echo "Not an HDR2 (tclinux) image"; return 1; }
+	[ "$(dd if="$1" bs=1 skip=92 count=12 2>/dev/null)" = "EN7523,GN630" ] || {
+		echo "HDR2 model is not EN7523,GN630"; return 1; }
+}
+
+gn630v_do_upgrade() {
+	local bank
+
+	# upgrade in place: the bank we run from. A RAM boot (no root=) installs
+	# to bank A, as in INSTALL.md.
+	bank=$(alphawrt_bank) || bank=a
+	echo "AlphaWRT: upgrading bank $bank"
+
+	# read the file directly: dd on a pipe can return short blocks
+	dd if="$1" bs=64k count=96 2>/dev/null |
+		mtd write - "$(alphawrt_part $bank kernel)" || return 1
+	dd if="$1" bs=64k skip=96 2>/dev/null |
+		mtd write - "$(alphawrt_part $bank rootfs)" || return 1
+
+	alphawrt_ubi_attach "$(alphawrt_part $bank data)" format || return 1
+	alphawrt_rootfs_data || return 1
+	alphawrt_set_bootflag $bank || return 1
+
+	[ -f "$UPGRADE_BACKUP" ] || return 0
+	busybox mkdir -p /tmp/new_root
+	mount -t ubifs ubi0:rootfs_data /tmp/new_root || return 1
+	busybox cp "$UPGRADE_BACKUP" "/tmp/new_root/$BACKUP_FILE"
+	umount /tmp/new_root
+}
+
 platform_do_upgrade() {
   local board=$(board_name)
 
   case "$board" in
+  skyworth,gn630v)
+    gn630v_do_upgrade "$1"
+    ;;
   askey,rtf8225vw |\
   genexis,arcee |\
   genexis,e650 |\
@@ -103,6 +140,10 @@ platform_check_image() {
   [ "$#" -gt 1 ] && return 1
 
   case "$board" in
+  skyworth,gn630v)
+    gn630v_check_image "$1"
+    return $?
+    ;;
   askey,rtf8225vw |\
   genexis,arcee |\
   genexis,e650 |\
diff --git a/target/linux/airoha/image/en7523.mk b/target/linux/airoha/image/en7523.mk
index 13f9942a58..6e96e66c1e 100644
--- a/target/linux/airoha/image/en7523.mk
+++ b/target/linux/airoha/image/en7523.mk
@@ -156,3 +156,45 @@ define Device/tplink_xx230v-v1
                      kmod-mt7915e kmod-mt7915-firmware kmod-mt7916-firmware
 endef
 TARGET_DEVICES += tplink_xx230v-v1
+
+# Skyworth GN630V: the vendor U-Boot boots a stock-format HDR2 bank image.
+# FIT with stock node names, fdt@1 first ("flash imgread" only reads the
+# first 0x800 bytes); see tclinux-fit.sh.
+define Build/gn630v-fit
+	PATH=$(LINUX_DIR)/scripts/dtc:$(PATH) ./tclinux-fit.sh $@ $(word 2,$(1)) \
+		$(KERNEL_LOADADDR) "OpenWrt $(DEVICE_NAME)" $@.new
+	mv $@.new $@
+endef
+
+# HDR2 + FIT padded to 6 MiB + squashfs: the layout of an AlphaWRT bank
+define Build/gn630v-trx
+	PAD_ROOTFS_OFFSET_TO=$$((6 * 1024 * 1024)) ./tclinux-trx.sh \
+		--kernel $@ --rootfs $(IMAGE_ROOTFS) --endian le \
+		--version $(VERSION_DIST)-$(REVISION) --model EN7523,GN630 \
+		--customer-version AlphaWRT --loadaddr 0x0 > $@.new
+	mv $@.new $@
+endef
+
+define Device/skyworth_gn630v
+  DEVICE_VENDOR := Skyworth
+  DEVICE_MODEL := GN630V
+  DEVICE_DTS := en7523-skyworth-gn630v
+  # no NPU firmware: the vendor blob is not redistributable
+  DEVICE_PACKAGES := kmod-mt7915e kmod-mt7916-firmware ubi-utils \
+	wpad-mbedtls iw -airoha-en7523-npu-firmware
+  KERNEL_NAME := Image
+  KERNEL := kernel-bin | lzma | \
+	gn630v-fit lzma $$(KDIR)/image-$$(firstword $$(DEVICE_DTS)).dtb
+  # RAM boot over U-Boot TFTP (bootm), see RECOVERY.md
+  KERNEL_INITRAMFS := kernel-bin | lzma | \
+	fit lzma $$(KDIR)/image-$$(firstword $$(DEVICE_DTS)).dtb
+  IMAGE_SIZE := 22528k
+  IMAGES := tclinux-factory.bin sysupgrade.bin
+  # tclinux-factory.bin: for the stock web UI firmware upgrade. The page only
+  # accepts file names containing "tclinux"; the firmware then checks the HDR2
+  # magic, CRC and model, writes the inactive bank and switches to it.
+  IMAGE/tclinux-factory.bin := append-kernel | gn630v-trx | check-size
+  IMAGE/sysupgrade.bin := append-kernel | gn630v-trx | check-size | \
+	append-metadata
+endef
+TARGET_DEVICES += skyworth_gn630v
