diff --git a/target/linux/airoha/image/en7523.mk b/target/linux/airoha/image/en7523.mk
index bdcca919d1..ab2473c0f7 100644
--- a/target/linux/airoha/image/en7523.mk
+++ b/target/linux/airoha/image/en7523.mk
@@ -17,3 +17,38 @@ define Device/airoha_en7523-ax3000-router
 	kmod-mt7915e kmod-mt7915-firmware kmod-mt7916-firmware fitblk
 endef
 TARGET_DEVICES += airoha_en7523-ax3000-router
+
+# FIT for the vendor U-Boot ("flash imgread"): stock node names, fdt@1 first.
+# See tclinux-fit.sh.
+define Build/tclinux-fit
+	PATH=$(LINUX_DIR)/scripts/dtc:$(PATH) ./tclinux-fit.sh $@ $(word 2,$(1)) \
+		$(KERNEL_LOADADDR) "OpenWrt $(DEVICE_NAME)" $@.new
+	mv $@.new $@
+endef
+
+# HDR2 + FIT padded to 6 MiB + squashfs: the layout of the AlphaWRT bank
+define Build/tclinux-trx
+	PAD_ROOTFS_OFFSET_TO=$$((6 * 1024 * 1024)) ./tclinux-trx.sh \
+		--kernel $@ --rootfs $(IMAGE_ROOTFS) --endian le \
+		--version $(VERSION_DIST)-$(REVISION) --model EN7523,GN630 \
+		--customer-version AlphaWRT --loadaddr 0x0 > $@.new
+	mv $@.new $@
+endef
+
+define Device/skyworth_gn630v
+  DEVICE_VENDOR := Skyworth
+  DEVICE_MODEL := GN630V
+  DEVICE_DTS := en7523-skyworth-gn630v
+  DEVICE_PACKAGES := kmod-mt7915e kmod-mt7916-firmware ubi-utils
+  KERNEL := kernel-bin | lzma | \
+	tclinux-fit lzma $$(KDIR)/image-$$(firstword $$(DEVICE_DTS)).dtb
+  IMAGE_SIZE := 22528k
+  IMAGES := tclinux-factory.bin sysupgrade.bin
+  # tclinux-factory.bin: for the stock web UI firmware upgrade. The page only
+  # accepts file names containing "tclinux"; the firmware then checks the HDR2
+  # magic, CRC and model, writes the inactive bank and switches to it.
+  IMAGE/tclinux-factory.bin := append-kernel | tclinux-trx | check-size
+  IMAGE/sysupgrade.bin := append-kernel | tclinux-trx | check-size | \
+	append-metadata
+endef
+TARGET_DEVICES += skyworth_gn630v
diff --git a/target/linux/airoha/image/tclinux-fit.sh b/target/linux/airoha/image/tclinux-fit.sh
new file mode 100755
index 0000000000..776489ce40
--- /dev/null
+++ b/target/linux/airoha/image/tclinux-fit.sh
@@ -0,0 +1,70 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0
+#
+# Build a FIT the EcoNet/Airoha vendor U-Boot ("flash imgread") can boot.
+# Its get_tclinux_imginfo() reads only the first 0x800 bytes of the FIT and
+# looks up /images/fdt@1 there, then kernel@1 and filesystem@1 by name. So:
+# stock node names, and fdt@1 must come first (mkits.sh puts the kernel
+# first). The rootfs lives outside the FIT; filesystem@1 is a stub.
+#
+# Usage: tclinux-fit.sh <kernel.lzma> <dtb> <loadaddr> <description> <out>
+
+set -e
+
+[ $# -eq 5 ] || { echo "usage: $0 <kernel.lzma> <dtb> <loadaddr> <description> <out>" >&2; exit 1; }
+kernel=$1 dtb=$2 loadaddr=$3 desc=$4 out=$5
+
+cat > "$out.its" <<EOF
+/dts-v1/;
+
+/ {
+	description = "$desc";
+	#address-cells = <1>;
+
+	images {
+		fdt@1 {
+			description = "$desc device tree";
+			data = /incbin/("$dtb");
+			type = "flat_dt";
+			arch = "arm";
+			compression = "none";
+			hash@1 {
+				algo = "sha1";
+			};
+		};
+
+		kernel@1 {
+			description = "$desc kernel";
+			data = /incbin/("$kernel");
+			type = "kernel";
+			arch = "arm";
+			os = "linux";
+			compression = "lzma";
+			load = <$loadaddr>;
+			entry = <$loadaddr>;
+			hash@1 {
+				algo = "sha1";
+			};
+		};
+
+		filesystem@1 {
+			description = "rootfs is outside the FIT";
+			data = <0x0>;
+			type = "filesystem";
+			arch = "arm";
+			compression = "none";
+		};
+	};
+
+	configurations {
+		default = "conf@1";
+		conf@1 {
+			description = "$desc";
+			kernel = "kernel@1";
+			fdt = "fdt@1";
+		};
+	};
+};
+EOF
+
+mkimage -f "$out.its" "$out"
diff --git a/target/linux/airoha/image/tclinux-trx.sh b/target/linux/airoha/image/tclinux-trx.sh
new file mode 100755
index 0000000000..d84c202335
--- /dev/null
+++ b/target/linux/airoha/image/tclinux-trx.sh
@@ -0,0 +1,235 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0
+
+set -e
+
+# Maximum kernel size
+# NOTE: We ff-pad the kernel and specify the fully padded length as the kernel
+#       size in the TRX header. This works around a bug wherein the bootloader
+#       reads the kernel length from the kernel in slot A, when it is booting
+#       slot B. By including the padding in the length, the kernel length is
+#       always the same, and the LZMA decompressor stops when it's done anyway.
+#       See: https://econet-linux.pkt.wiki/en/bootloader#a-length-bug
+PAD_ROOTFS_OFFSET_TO=${PAD_ROOTFS_OFFSET_TO:-$((4 * 1024 * 1024))}
+
+# Constant
+HDRLEN=256
+
+die() {
+    echo "$1" >&2
+    exit 1
+}
+
+usage() {
+    cat >&2 <<EOF
+SYNTAX: $0 --kernel <file> --rootfs <file> --version <string> [options]
+
+Options:
+  --kernel   Path to kernel lzma file (required)
+  --rootfs   Path to rootfs squashfs file
+  --version  Version string, max 31 chars (required)
+  --endian   Endianness: 'be' for big endian, 'le' for little endian (default: be)
+  --model    Model/platform name, max 31 chars (default: empty)
+  --customer-version
+             Customer version string, max 31 chars, newline-terminated like
+             --version (default: empty). The Skyworth GN630V stock web
+             upgrade crashes on an empty one (strncpy of strlen-1 bytes).
+  --loadaddr Address the bootloader decompresses the kernel to
+             (default: 0x80020000)
+EOF
+    exit 1
+}
+
+# Defaults
+kernel=""
+rootfs=""
+version=""
+endian="be"
+model=""
+custversion=""
+loadaddr="0x80020000"
+
+# Parse named arguments
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --kernel)
+            kernel="$2"
+            shift 2
+            ;;
+        --rootfs)
+            rootfs="$2"
+            shift 2
+            ;;
+        --version)
+            version="$2"
+            shift 2
+            ;;
+        --endian)
+            endian="$2"
+            shift 2
+            ;;
+        --model)
+            model="$2"
+            shift 2
+            ;;
+        --customer-version)
+            custversion="$2"
+            shift 2
+            ;;
+        --loadaddr)
+            loadaddr="$2"
+            shift 2
+            ;;
+        -h|--help)
+            usage
+            ;;
+        *)
+            die "Unknown option: $1"
+            ;;
+    esac
+done
+
+# Validate required arguments
+[ -n "$kernel" ] || die "Missing required argument: --kernel"
+[ -n "$version" ] || die "Missing required argument: --version"
+
+# Validate endianness
+case "$endian" in
+    be|BE) endian="be" ;;
+    le|LE) endian="le" ;;
+    *) die "Invalid endianness: $endian (must be 'be' or 'le')" ;;
+esac
+
+which zytrx >/dev/null || die "zytrx not found in PATH $PATH"
+[ -f "$kernel" ] || die "Kernel file not found: $kernel"
+[ -z "$rootfs" ] || [ -f "$rootfs" ] || die "Rootfs file not found: $rootfs"
+[ "$(echo "$version" | wc -c)" -lt 32 ] || die "Version string too long: $version"
+[ -z "$model" ] || [ "$(printf '%s' "$model" | wc -c)" -lt 32 ] || die "Model string too long: $model"
+[ -z "$custversion" ] || [ "$(echo "$custversion" | wc -c)" -lt 32 ] || die "Customer version too long: $custversion"
+
+kernel_len=$(stat -c '%s' "$kernel")
+header_plus_kernel_len=$(($HDRLEN + $kernel_len))
+rootfs_len=0
+if [ -f "$rootfs" ]; then
+    rootfs_len=$(stat -c '%s' "$rootfs")
+fi
+
+[ "$PAD_ROOTFS_OFFSET_TO" -gt "$header_plus_kernel_len" ] || die "kernel is too large"
+
+padding_len=$(($PAD_ROOTFS_OFFSET_TO - $header_plus_kernel_len))
+
+echo "endian: $endian" >&2
+echo "padding_len: $padding_len" >&2
+
+padded_kernel_len=$(($padding_len + $kernel_len))
+
+total_len=$(($PAD_ROOTFS_OFFSET_TO + $rootfs_len))
+
+echo "total_len: $total_len" >&2
+
+padding() {
+    head -c $padding_len /dev/zero | tr '\0' '\377'
+}
+
+to_hex() {
+    hexdump -v -e '1/1 "%02x"'
+}
+
+from_hex() {
+    perl -pe 's/\s+//g; s/(..)/chr(hex($1))/ge'
+}
+
+# Output a 32-bit value in hex with correct endianness
+# Usage: hex32 <value>
+hex32() {
+    val=$(printf '%08x' "$1")
+    if [ "$endian" = "le" ]; then
+        # Swap bytes for little endian: AABBCCDD -> DDCCBBAA
+        echo "$val" | sed 's/\(..\)\(..\)\(..\)\(..\)/\4\3\2\1/'
+    else
+        echo "$val"
+    fi
+}
+
+trx_crc32() {
+    tmpfile=$(mktemp)
+    outtmpfile=$(mktemp)
+    cat "$kernel" > "$tmpfile"
+    padding >> "$tmpfile"
+    if [ -f "$rootfs" ]; then
+        cat "$rootfs" >> "$tmpfile"
+    fi
+    # We just need a CRC-32/JAMCRC of the concatnated files
+    # There's no readily available tool for this, but zytrx does create one when
+    # creating their TRX header, so we just use that.
+    zytrx \
+        -B NR7101 \
+        -v x \
+        -i "$tmpfile" \
+        -o "$outtmpfile" >/dev/null
+    crc_hex=$(dd if="$outtmpfile" bs=4 count=1 skip=3 2>/dev/null | to_hex)
+    rm "$tmpfile" "$outtmpfile" >/dev/null
+    hex32 "0x$crc_hex"
+}
+
+tclinux_trx_hdr() {
+    # TRX header magic: "2RDH" for big endian, "HDR2" for little endian
+    if [ "$endian" = "le" ]; then
+        printf 'HDR2' | to_hex
+    else
+        printf '2RDH' | to_hex
+    fi
+
+    # Length of the header
+    hex32 "$HDRLEN"
+
+    # Length of header + content
+    hex32 "$total_len"
+
+    # crc32 of the content
+    trx_crc32
+
+    # version
+    echo "$version" | to_hex
+    head -c "$((32 - $(echo "$version" | wc -c)))" /dev/zero | to_hex
+
+    # customer version
+    if [ -n "$custversion" ]; then
+        echo "$custversion" | to_hex
+        head -c "$((32 - $(echo "$custversion" | wc -c)))" /dev/zero | to_hex
+    else
+        head -c 32 /dev/zero | to_hex
+    fi
+
+    # kernel length
+    hex32 "$padded_kernel_len"
+
+    # rootfs length
+    hex32 "$rootfs_len"
+
+    # romfile length (0)
+    hex32 0
+
+    # model (32 bytes, zero-padded)
+    if [ -n "$model" ]; then
+        printf '%s' "$model" | to_hex
+        head -c "$((32 - $(printf '%s' "$model" | wc -c)))" /dev/zero | to_hex
+    else
+        head -c 32 /dev/zero | to_hex
+    fi
+
+    # Address the bootloader decompresses to. Note that some bootloaders
+    # read this field from the image in slot A even when booting slot B,
+    # so both slots need the same value.
+    hex32 "$loadaddr"
+
+    # "reserved" 128 bytes of zeros
+    head -c 128 /dev/zero | to_hex
+}
+
+tclinux_trx_hdr | from_hex
+cat "$kernel"
+padding
+if [ -f "$rootfs" ]; then
+    cat "$rootfs"
