From 57541a4c0af793140feaf384f90518d8e258e1ba Mon Sep 17 00:00:00 2001
From: idiazraz <100824525+idiazraz@users.noreply.github.com>
Date: Sun, 25 Oct 2026 12:34:58 +0800
Subject: [PATCH 11/20] airoha: en7523: gn630v: hardware offload for IPv4 TCP

The offload flowtable and its chain live in their own table,
inet alphawrt_hw, loaded by fw4 at ruleset-post. Inside table inet fw4,
ft_hw shared pon0 with fw4's own flowtable whenever the WAN is a bare
pon0 (every fresh install), and nf_tables refuses one device in two
flowtables of the same table, so the whole firewall failed to load and
the LAN was locked out.
---
 .../etc/uci-defaults/96_alphawrt_offload      | 14 +++++++++--
 .../usr/share/alphawrt/gn630v-hw-offload.nft  | 25 +++++++++++++++++++
 2 files changed, 37 insertions(+), 2 deletions(-)
 create mode 100644 target/linux/airoha/en7523/base-files/usr/share/alphawrt/gn630v-hw-offload.nft

diff --git a/target/linux/airoha/en7523/base-files/etc/uci-defaults/96_alphawrt_offload b/target/linux/airoha/en7523/base-files/etc/uci-defaults/96_alphawrt_offload
index f27c83b017..8fa7f59d84 100755
--- a/target/linux/airoha/en7523/base-files/etc/uci-defaults/96_alphawrt_offload
+++ b/target/linux/airoha/en7523/base-files/etc/uci-defaults/96_alphawrt_offload
@@ -2,8 +2,18 @@
 # AlphaWRT: routing on both cores. Software flow offload lets established
 # connections skip most of the firewall, and packet steering spreads the
 # receive work over the two CPUs (about 2x download in combo mode on a
-# 1 Gbps TIME line, 2026-10-25). The PPE hardware offload stays off until it
-# passes a controlled test: with it on, some offloaded connections stalled.
+# 1 Gbps TIME line, 2026-10-25). IPv4 TCP goes to the PPE hardware through
+# its own flowtable in its own table (GN630V: about 900 down / 550 up), so
+# fw4's own flowtable stays software-only: offloaded IPv6 entries pass no
+# traffic on EN7523 yet. The old copy inside table inet fw4 broke the
+# firewall on a bare pon0 WAN (issues/0001), so it is removed here.
+
+. /lib/functions.sh
+rm -f /etc/nftables.d/20-alphawrt-hw-offload.nft
+[ "$(board_name)" = "skyworth,gn630v" ] && {
+	mkdir -p /usr/share/nftables.d/ruleset-post
+	cp /usr/share/alphawrt/gn630v-hw-offload.nft /usr/share/nftables.d/ruleset-post/20-alphawrt-hw-offload.nft
+}
 
 uci -q batch <<UCI
 set firewall.@defaults[0].flow_offloading=1
diff --git a/target/linux/airoha/en7523/base-files/usr/share/alphawrt/gn630v-hw-offload.nft b/target/linux/airoha/en7523/base-files/usr/share/alphawrt/gn630v-hw-offload.nft
new file mode 100644
index 0000000000..b3eb4b7ee5
--- /dev/null
+++ b/target/linux/airoha/en7523/base-files/usr/share/alphawrt/gn630v-hw-offload.nft
@@ -0,0 +1,25 @@
+# AlphaWRT: hardware (PPE) offload for IPv4 TCP only. On EN7523 the
+# offloaded IPv6 entries pass no traffic (source MAC/PPPoE layout), so IPv6
+# and UDP stay in fw4's software flowtable "ft". Runs just before fw4's
+# forward chain, so these flows land here first.
+#
+# Its own table, loaded at ruleset-post: nf_tables refuses one device in
+# two flowtables of the same table, so with a bare pon0 WAN (every fresh
+# install) ft_hw inside inet fw4 made the whole firewall fail to load and
+# locked the LAN out (issues/0001).
+table inet alphawrt_hw
+delete table inet alphawrt_hw
+
+table inet alphawrt_hw {
+	flowtable ft_hw {
+		hook ingress priority filter
+		devices = { "lan1", "lan2", "lan3", "lan4", "pon0" }
+		flags offload
+		counter
+	}
+
+	chain forward {
+		type filter hook forward priority filter - 1; policy accept;
+		meta nfproto ipv4 meta l4proto tcp flow add @ft_hw
+	}
+}
