Subject: [PATCH 09/13] airoha: ppe: EN7523 IPv6 entries and offload mask

---
 ...en7523-ipv6-entries-and-offload-mask.patch | 77 +++++++++++++++++++
 1 file changed, 77 insertions(+)
 create mode 100644 target/linux/airoha/patches-6.18/993-net-airoha-ppe-en7523-ipv6-entries-and-offload-mask.patch

diff --git a/target/linux/airoha/patches-6.18/993-net-airoha-ppe-en7523-ipv6-entries-and-offload-mask.patch b/target/linux/airoha/patches-6.18/993-net-airoha-ppe-en7523-ipv6-entries-and-offload-mask.patch
new file mode 100644
index 0000000000..47e5108b21
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/993-net-airoha-ppe-en7523-ipv6-entries-and-offload-mask.patch
@@ -0,0 +1,77 @@
+From: idiazraz <100824525+idiazraz@users.noreply.github.com>
+Subject: [PATCH] net: airoha: ppe: EN7523 IPv6 entries and offload mask
+
+EN7523 IPv6 FOE entries carry the full source MAC and a
+SMAC[15:0] | PPPoE ID word like IPv4 ones (layout from the vendor
+hw_nat), not the EN7581 SMAC_ID index: with the index, bound IPv6 flows
+went out with garbage source MACs and passed no traffic over PPPoE.
+
+Also add an en7523_offload module parameter selecting which flow kinds
+are offloaded (IPv4/IPv6 x TCP/UDP), writable at runtime. It defaults to
+IPv4 TCP, the only kind verified on a GPON ONT routing PPPoE; the rest
+stay in the software flowtable.
+---
+--- a/drivers/net/ethernet/airoha/airoha_ppe.c
++++ b/drivers/net/ethernet/airoha/airoha_ppe.c
+@@ -14,6 +14,16 @@
+ #include <net/flow_offload.h>
+ #include <net/netlink.h>
+ #include <net/pkt_cls.h>
++
++/*
++ * EN7523 hardware offload per flow kind, writable at runtime: bit 0 IPv4
++ * TCP, bit 1 IPv4 UDP, bit 2 IPv6 TCP, bit 3 IPv6 UDP. Only IPv4 TCP has
++ * been verified on a GPON ONT routing PPPoE (line rate both ways).
++ */
++static unsigned int en7523_offload = BIT(0);
++module_param(en7523_offload, uint, 0644);
++MODULE_PARM_DESC(en7523_offload,
++		 "EN7523 PPE offload mask: 1 IPv4 TCP, 2 IPv4 UDP, 4 IPv6 TCP, 8 IPv6 UDP");
+ #include <net/route.h>
+ #include <uapi/linux/ppp_defs.h>
+ 
+@@ -757,14 +767,18 @@
+ 
+ 	l2->dest_mac_hi = get_unaligned_be32(data->eth.h_dest);
+ 	l2->dest_mac_lo = get_unaligned_be16(data->eth.h_dest + 4);
+-	if (type <= PPE_PKT_TYPE_IPV4_DSLITE) {
++	/*
++	 * EN7523 has no SMAC table indirection for IPv6 either: its IPv6 entries
++	 * carry SMAC[47:16] and a SMAC[15:0] | PPPoE ID word like IPv4 (layout
++	 * from the vendor hw_nat). The SMAC_ID form put garbage source MACs and
++	 * no PPPoE session on the wire.
++	 */
++	if (type <= PPE_PKT_TYPE_IPV4_DSLITE || airoha_is(eth, airoha_en7523)) {
+ 		struct airoha_foe_mac_info *mac_info;
+ 
+-		l2->src_mac_hi = get_unaligned_be32(data->eth.h_source);
+-		hwe->ipv4.l2.src_mac_lo =
+-			get_unaligned_be16(data->eth.h_source + 4);
+-
+ 		mac_info = (struct airoha_foe_mac_info *)l2;
++		l2->src_mac_hi = get_unaligned_be32(data->eth.h_source);
++		mac_info->src_mac_lo = get_unaligned_be16(data->eth.h_source + 4);
+ 		mac_info->pppoe_id = data->pppoe.sid;
+ 	} else {
+ 		l2->src_mac_hi = FIELD_PREP(AIROHA_FOE_MAC_SMAC_ID, smac_id) |
+@@ -1877,6 +1891,20 @@
+ 		return -EOPNOTSUPP;
+ 	}
+ 
++	/*
++	 * EN7523: offload only the flow kinds en7523_offload allows; the rest
++	 * stay in the software flowtable.
++	 */
++	if (airoha_is(eth, airoha_en7523)) {
++		bool ipv6 = addr_type == FLOW_DISSECTOR_KEY_IPV6_ADDRS;
++
++		if ((!ipv6 && addr_type != FLOW_DISSECTOR_KEY_IPV4_ADDRS) ||
++		    (l4proto != IPPROTO_TCP && l4proto != IPPROTO_UDP) ||
++		    !(READ_ONCE(en7523_offload) &
++		      BIT(ipv6 * 2 + (l4proto == IPPROTO_UDP))))
++			return -EOPNOTSUPP;
++	}
++
+ 	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_IP)) {
+ 		struct flow_match_ip match;
+ 
