From 2d64d8eafb4f7d530b5787a7b05c20bfb495a469 Mon Sep 17 00:00:00 2001
From: AlphaWRT <build@alphawrt.invalid>
Date: Wed, 4 Nov 2026 16:37:54 +0800
Subject: [PATCH] mt76: npu: hand the MT7916 rings to the NPU before RX
 DMA starts

The NPU took the rings but the card never completed a descriptor on
them. Three fixes, all matching the vendor driver's boot log:
- hand the rings over in mt7915_dma_init, before RX DMA is enabled
  (a live swap leaves the WFDMA on 4 prefetched host descriptors);
- port type P0_P1 and band1 through the hif2 BAR on a dual-link card;
- send PCIE_STATE (link up) for each port.

The NPU now consumes both band rings. It does not yet deliver frames
to the host rings, so npu_enable=1 still has no working Wi-Fi.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ...-offload-MT7916-RX-to-the-EN7523-NPU.patch | 90 ++++++++++++-------
 1 file changed, 59 insertions(+), 31 deletions(-)

diff --git a/package/kernel/mt76/patches/165-mt7915-offload-MT7916-RX-to-the-EN7523-NPU.patch b/package/kernel/mt76/patches/165-mt7915-offload-MT7916-RX-to-the-EN7523-NPU.patch
index d7c8aac161..1baa35768e 100644
--- a/package/kernel/mt76/patches/165-mt7915-offload-MT7916-RX-to-the-EN7523-NPU.patch
+++ b/package/kernel/mt76/patches/165-mt7915-offload-MT7916-RX-to-the-EN7523-NPU.patch
@@ -2,14 +2,20 @@ From: AlphaWRT <build@alphawrt.invalid>
 Subject: [PATCH] mt7915: offload MT7916 RX to the EN7523 NPU
 
 With npu_enable=1 the EN7523 NPU takes over the MT7916 MAIN and BAND1
-RX rings (MT7916_D DBDC model, P0_P0 port type), as the vendor driver
-does. The host reads 802.3 frames from the NPU's WLAN RX rings 0/1
-(16-byte v1 descriptors) and feeds unbound PPE flows back through
+RX rings (MT7916_D DBDC model), as the vendor driver does. The rings
+are handed over in mt7915_dma_init, before RX DMA starts: swapping a
+running ring leaves the WFDMA on its prefetched host descriptors and
+RX stalls. On a dual-link card (hif2) the port type is P0_P1 and
+band1 is addressed through the BAR of its own link. The host reads
+802.3 frames from the NPU's WLAN RX rings 0/1 (16-byte v1
+descriptors) and feeds unbound PPE flows back through
 airoha_ppe_dev_check_skb_reason so Wi-Fi to WAN flows can bind.
 
-Limit: frames split over several buffers are dropped, a DMA reset
-points the card back at the host rings (CPU path), and no BA window
-mail is sent (mt76 still reorders on the host). Off by default.
+Limit: the NPU now takes the frames but does not yet hand them to
+the host rings (it queues 256 and drops the rest), so Wi-Fi does not
+work with npu_enable=1. Frames split over several buffers are
+dropped, a DMA reset points the card back at the host rings, and no
+BA window mail is sent. Off by default.
 
 --- a/mt7915/Makefile
 +++ b/mt7915/Makefile
@@ -40,20 +46,17 @@ mail is sent (mt76 still reorders on the host). Off by default.
  	struct mt7915_reg_desc reg;
  	u8 q_id[MT7915_MAX_QUEUE];
  	u32 q_int_mask[MT7915_MAX_QUEUE];
-@@ -667,6 +670,31 @@
+@@ -667,6 +670,28 @@
  void mt7915_sta_add_debugfs(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
  			    struct ieee80211_sta *sta, struct dentry *dir);
  #endif
-+struct pci_dev;
-+
 +#if IS_ENABLED(CONFIG_NET_AIROHA_NPU)
-+int mt7915_npu_init(struct mt7915_dev *dev, struct pci_dev *pdev);
++int mt7915_npu_init(struct mt7915_dev *dev);
 +void mt7915_npu_deinit(struct mt7915_dev *dev);
 +void mt7915_npu_check_ppe(struct mt7915_dev *dev, enum mt76_rxq_id q,
 +			  struct sk_buff *skb, u32 info);
 +#else
-+static inline int mt7915_npu_init(struct mt7915_dev *dev,
-+				  struct pci_dev *pdev)
++static inline int mt7915_npu_init(struct mt7915_dev *dev)
 +{
 +	return 0;
 +}
@@ -72,9 +75,33 @@ mail is sent (mt76 still reorders on the host). Off by default.
  int mt7915_mmio_wed_init(struct mt7915_dev *dev, void *pdev_ptr,
  			 bool pci, int *irq);
  
+--- a/mt7915/dma.c
++++ b/mt7915/dma.c
+@@ -341,6 +341,8 @@
+ 	}
+ 
+ 	irq_mask = reset ? MT_INT_MCU_CMD : irq_mask;
++	if (dev->npu)
++		irq_mask &= ~(MT_INT_RX(MT_RXQ_MAIN) | MT_INT_RX(MT_RXQ_BAND1));
+ 
+ 	mt7915_irq_enable(dev, irq_mask);
+ 	mt7915_irq_disable(dev, 0);
+@@ -599,6 +601,12 @@
+ 			  mt7915_poll_tx);
+ 	napi_enable(&dev->mt76.tx_napi);
+ 
++	/* Note: the NPU takes the band RX rings before RX DMA starts, as
++	 * the vendor driver does. Swapping a running ring leaves the WFDMA
++	 * on its prefetched host descriptors and RX stalls.
++	 */
++	mt7915_npu_init(dev);
++
+ 	mt7915_dma_enable(dev, false);
+ 
+ 	return 0;
 --- /dev/null
 +++ b/mt7915/npu.c
-@@ -0,0 +1,406 @@
+@@ -0,0 +1,417 @@
 +// SPDX-License-Identifier: BSD-3-Clause-Clear
 +/*
 + * EN7523 NPU Wi-Fi RX offload for MT7916 (NPU firmware V1).
@@ -116,6 +143,7 @@ mail is sent (mt76 still reorders on the host). Off by default.
 +/* V1 firmware values for SET DRIVER_MODEL and SET PCIE_PORT_TYPE */
 +#define NPU_MODEL_MT7916_DBDC	2
 +#define NPU_PORT_P0_P0		2
++#define NPU_PORT_P0_P1		3	/* band1 on the second PCIe link (hif2) */
 +
 +struct mt7915_npu_desc {
 +	u32 ctrl;
@@ -353,16 +381,19 @@ mail is sent (mt76 still reorders on the host). Off by default.
 +	kfree(np);
 +}
 +
-+int mt7915_npu_init(struct mt7915_dev *dev, struct pci_dev *pdev)
++int mt7915_npu_init(struct mt7915_dev *dev)
 +{
 +	struct mt76_dev *mdev = &dev->mt76;
 +	struct device *dma_dev;
 +	struct mt7915_npu *np;
++	struct pci_dev *pdev;
 +	int n, err;
 +
 +	if (!npu_enable || !is_mt7916(mdev))
 +		return 0;
 +
++	pdev = to_pci_dev(mdev->dev);
++
 +	np = kzalloc(sizeof(*np), GFP_KERNEL);
 +	if (!np)
 +		return -ENOMEM;
@@ -402,17 +433,25 @@ mail is sent (mt76 still reorders on the host). Off by default.
 +	err = mt7915_npu_set(np, 0, WLAN_FUNC_SET_WAIT_DRIVER_MODEL,
 +			     NPU_MODEL_MT7916_DBDC) ?:
 +	      mt7915_npu_set(np, 0, WLAN_FUNC_SET_WAIT_PCIE_PORT_TYPE,
-+			     NPU_PORT_P0_P0) ?:
++			     dev->hif2 ? NPU_PORT_P0_P1 : NPU_PORT_P0_P0) ?:
 +	      mt7915_npu_set(np, 0, WLAN_FUNC_SET_WAIT_DRAM_BA_NODE_ADDR,
 +			     np->ba_dma);
 +	for (n = 0; !err && n < ARRAY_SIZE(np->ring); n++) {
 +		struct mt76_queue *q = &mdev->q_rx[mt7915_npu_qid(n)];
 +		u32 regs = (void __iomem *)q->regs - mdev->mmio.regs;
++		/* Note: as the vendor driver, band1 is addressed through the
++		 * BAR of the link that carries it.
++		 */
++		struct pci_dev *bar = n && dev->hif2 ?
++				      to_pci_dev(dev->hif2->dev) : pdev;
 +
 +		err = mt7915_npu_set(np, n, WLAN_FUNC_SET_WAIT_PCIE_ADDR,
-+				     pci_resource_start(pdev, 0) + regs) ?:
++				     pci_resource_start(bar, 0) + regs) ?:
 +		      mt7915_npu_set(np, n, WLAN_FUNC_SET_WAIT_DESC,
-+				     MT7915_RX_RING_SIZE);
++				     MT7915_RX_RING_SIZE) ?:
++		      /* Note: tells the firmware the port's link is up. */
++		      mt7915_npu_set(np, n, WLAN_FUNC_SET_WAIT_PCIE_STATE,
++				     pci_resource_start(bar, 0));
 +	}
 +	if (err)
 +		goto error;
@@ -424,10 +463,9 @@ mail is sent (mt76 still reorders on the host). Off by default.
 +	}
 +
 +	/* From here the MT7916 band rings belong to the NPU: their own IRQs
-+	 * stay off and the host reads the NPU rings instead.
++	 * stay off (mt7915_dma_start) and the host reads the NPU rings
++	 * instead.
 +	 */
-+	mt7915_irq_disable(dev, MT_INT_RX(MT_RXQ_MAIN) |
-+				MT_INT_RX(MT_RXQ_BAND1));
 +	dev->npu = np;
 +	for (n = 0; n < ARRAY_SIZE(np->ring); n++) {
 +		struct mt76_queue *q = &mdev->q_rx[mt7915_npu_qid(n)];
@@ -483,17 +521,7 @@ mail is sent (mt76 still reorders on the host). Off by default.
 +}
 --- a/mt7915/pci.c
 +++ b/mt7915/pci.c
-@@ -183,6 +183,9 @@
- 	if (ret)
- 		goto free_hif2_irq;
- 
-+	/* Note: without the NPU, RX stays on the host rings. */
-+	mt7915_npu_init(dev, pdev);
-+
- 	return 0;
- 
- free_hif2_irq:
-@@ -217,6 +220,7 @@
+@@ -217,6 +217,7 @@
  
  	mdev = pci_get_drvdata(pdev);
  	dev = container_of(mdev, struct mt7915_dev, mt76);
