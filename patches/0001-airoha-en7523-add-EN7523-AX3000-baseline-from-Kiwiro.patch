++    minItems: 5
++    maxItems: 12
++
++  reg-names:
++    minItems: 1
++    maxItems: 12
++
++  airoha,scu:
++    $ref: /schemas/types.yaml#/definitions/phandle
++    description: Phandle to the EN7523 NP SCU syscon.
++
++  resets:
++    minItems: 1
++    maxItems: 2
++
++  reset-names:
++    items:
++      - const: mac
++      - const: phy
