diff --git a/target/linux/airoha/patches-6.18/930-42-airoha_en7523_all-airoha_en7523_eth-allocate-GDM-ports-before-QDMA-hw-.patch b/target/linux/airoha/patches-6.18/930-42-airoha_en7523_all-airoha_en7523_eth-allocate-GDM-ports-before-QDMA-hw-.patch
new file mode 100644
index 0000000000..94fde05389
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/930-42-airoha_en7523_all-airoha_en7523_eth-allocate-GDM-ports-before-QDMA-hw-.patch
@@ -0,0 +1,92 @@
+From a606c062960289b8f2ea9e807fb39c4010e24325 Mon Sep 17 00:00:00 2001
+From: Benjamin Larsson <noreply@localhost>
+Date: Thu, 11 Jun 2026 02:20:00 +0000
+Subject: [PATCH 042/131] airoha_en7523_eth: allocate GDM ports before QDMA hw
+ init
+
+airoha_probe() brought up the QDMA hardware (airoha_hw_init() +
+airoha_qdma_start_napi()) before allocating the GDM ports. The GDM port
+allocation reads the port MAC address via of_get_ethdev_address(), which
+on boards that store the MAC in a late-registering nvmem provider (e.g. a
+U-Boot env or fixed-layout cell on a UBI volume) returns -EPROBE_DEFER.
+
+On that defer the probe error path runs airoha_hw_cleanup() ->
+page_pool_destroy() while the RX DMA is already live. page_pool_destroy()
+then busy-waits for in-flight RX pages that are never returned, live-locks
+against the RX softirq and hangs the CPU - so the deferred probe is never
+retried and the board never boots.
+
+Allocate the GDM ports (and thus read the MAC) before airoha_hw_init() so
+an -EPROBE_DEFER unwinds before any RX ring or page pool exists. Add an
+error_ports_free label for the pre-hardware unwind; the post-hardware
+failure path keeps stopping NAPI and calling airoha_hw_cleanup().
+
+Signed-off-by: Benjamin Larsson <noreply@localhost>
+Signed-off-by: Matheus Sampaio Queiroga <noreply@localhost>
+---
+ drivers/net/ethernet/airoha/airoha_eth.c | 30 +++++++++++++++---------
+ 1 file changed, 19 insertions(+), 11 deletions(-)
+
+--- a/drivers/net/ethernet/airoha/airoha_eth.c
++++ b/drivers/net/ethernet/airoha/airoha_eth.c
+@@ -4084,13 +4084,15 @@ static int airoha_probe(struct platform_
+ 	strscpy(eth->napi_dev->name, "qdma_eth", sizeof(eth->napi_dev->name));
+ 	platform_set_drvdata(pdev, eth);
+ 
+-	err = airoha_hw_init(pdev, eth);
+-	if (err)
+-		goto error_netdev_free;
+-
+-	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++)
+-		airoha_qdma_start_napi(&eth->qdma[i]);
+-
++	/* Allocate the GDM ports before bringing up the QDMA hardware. This
++	 * reads the port MAC address, which may be supplied by a late nvmem
++	 * provider (e.g. a U-Boot env or fixed-layout cell on a UBI volume)
++	 * and can therefore return -EPROBE_DEFER. Doing it before
++	 * airoha_hw_init() guarantees such a defer unwinds before any RX ring
++	 * or page pool exists; otherwise the error path would call
++	 * page_pool_destroy() while RX DMA is still running, which live-locks
++	 * against the RX softirq and hangs the CPU before the probe is retried.
++	 */
+ 	for_each_child_of_node(pdev->dev.of_node, np) {
+ 		if (!of_device_is_compatible(np, "airoha,eth-mac"))
+ 			continue;
+@@ -4101,10 +4103,17 @@ static int airoha_probe(struct platform_
+ 		err = airoha_alloc_gdm_port(eth, np);
+ 		if (err) {
+ 			of_node_put(np);
+-			goto error_napi_stop;
++			goto error_ports_free;
+ 		}
+ 	}
+ 
++	err = airoha_hw_init(pdev, eth);
++	if (err)
++		goto error_ports_free;
++
++	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++)
++		airoha_qdma_start_napi(&eth->qdma[i]);
++
+ 	err = airoha_register_gdm_devices(eth);
+ 	if (err)
+ 		goto error_napi_stop;
+@@ -4114,7 +4123,8 @@ static int airoha_probe(struct platform_
+ error_napi_stop:
+ 	for (i = 0; i < ARRAY_SIZE(eth->qdma); i++)
+ 		airoha_qdma_stop_napi(&eth->qdma[i]);
+-
++	airoha_hw_cleanup(eth);
++error_ports_free:
+ 	for (i = 0; i < ARRAY_SIZE(eth->ports); i++) {
+ 		struct airoha_gdm_port *port = eth->ports[i];
+ 		int j;
+@@ -4138,8 +4148,6 @@ error_napi_stop:
+ 		}
+ 		airoha_metadata_dst_free(port);
+ 	}
+-	airoha_hw_cleanup(eth);
+-error_netdev_free:
+ 	free_netdev(eth->napi_dev);
+ 	platform_set_drvdata(pdev, NULL);
+ 
diff --git a/target/linux/airoha/patches-6.18/930-43-airoha_en7523_all-net-dsa-mt7530-Add-EN7523-support.patch b/target/linux/airoha/patches-6.18/930-43-airoha_en7523_all-net-dsa-mt7530-Add-EN7523-support.patch
new file mode 100644
index 0000000000..d00b4ca4fc
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/930-43-airoha_en7523_all-net-dsa-mt7530-Add-EN7523-support.patch
@@ -0,0 +1,166 @@
+From 2bf0194fb6e6d510ef504f8d8183647302d7d260 Mon Sep 17 00:00:00 2001
+From: Matheus Sampaio Queiroga <noreply@localhost>
+Date: Thu, 8 Jan 2026 23:23:54 -0300
+Subject: [PATCH 043/131] net: dsa: mt7530: Add EN7523 support
+
+Add Airoha EN7523 Switch support. This is based on Airoha EN7581 that is
+based on Mediatek MT7988 Switch.
+
+Signed-off-by: Matheus Sampaio Queiroga <noreply@localhost>
+---
+ drivers/net/dsa/mt7530-mmio.c |  1 +
+ drivers/net/dsa/mt7530.c      | 25 +++++++++++++++++++++++--
+ drivers/net/dsa/mt7530.h      | 34 +++++++++++++++++++++++++++++-----
+ 3 files changed, 53 insertions(+), 7 deletions(-)
+
+--- a/drivers/net/dsa/mt7530-mmio.c
++++ b/drivers/net/dsa/mt7530-mmio.c
+@@ -11,6 +11,7 @@
+ #include "mt7530.h"
+ 
+ static const struct of_device_id mt7988_of_match[] = {
++	{ .compatible = "airoha,en7523-switch", .data = &mt753x_table[ID_EN7523], },
+ 	{ .compatible = "airoha,an7583-switch", .data = &mt753x_table[ID_AN7583], },
+ 	{ .compatible = "airoha,en7581-switch", .data = &mt753x_table[ID_EN7581], },
+ 	{ .compatible = "mediatek,mt7988-switch", .data = &mt753x_table[ID_MT7988], },
+--- a/drivers/net/dsa/mt7530.c
++++ b/drivers/net/dsa/mt7530.c
+@@ -1287,7 +1287,8 @@ mt753x_cpu_port_enable(struct dsa_switch
+ 	 * is affine to the inbound user port.
+ 	 */
+ 	if (priv->id == ID_MT7531 || priv->id == ID_MT7988 ||
+-	    priv->id == ID_EN7581 || priv->id == ID_AN7583)
++	    priv->id == ID_EN7581 || priv->id == ID_AN7583 ||
++			priv->id == ID_EN7523)
+ 		mt7530_set(priv, MT7531_CFC, MT7531_CPU_PMAP(BIT(port)));
+ 
+ 	/* CPU port gets connected to all user ports of
+@@ -2607,7 +2608,7 @@ mt7531_setup_common(struct dsa_switch *d
+ 	mt7530_set(priv, MT753X_AGC, LOCAL_EN);
+ 
+ 	/* Enable Special Tag for rx frames */
+-	if (priv->id == ID_EN7581 || priv->id == ID_AN7583)
++	if (priv->id == ID_EN7581 || priv->id == ID_AN7583 || priv->id == ID_EN7523)
+ 		mt7530_write(priv, MT753X_CPORT_SPTAG_CFG,
+ 			     CPORT_SW2FE_STAG_EN | CPORT_FE2SW_STAG_EN);
+ 
+@@ -3241,6 +3242,16 @@ static int mt7988_setup(struct dsa_switc
+ 			   AN7583_CSR_PHY_CORE_REG_CLK_SEL |
+ 			   FIELD_PREP(AN7583_CSR_ETHER_AFE_PWD, 0));
+ 
++	if (priv->id == ID_EN7523) {
++		mt7530_set(priv, MT753X_PMCR_P(6), MT7530_RXCRC_EN |
++			   PMCR_IFG_XMIT(1) |
++			   PMCR_MAC_MODE |
++			   PMCR_BACKOFF_EN |
++			   PMCR_BACKPR_EN);
++		mt7530_set(priv, MT7530_DBGGCR, CPORT_RXG_BUSY);
++		mt7530_write(priv, MT7530_CKGCR, LPI_TXIDLE_THD(0xFF));
++	}
++
+ 	/* Reset the switch PHYs */
+ 	mt7530_write(priv, MT7530_SYS_CTRL, SYS_CTRL_PHY_RST);
+ 
+@@ -3354,6 +3365,16 @@ const struct mt753x_info mt753x_table[]
+ 		.pcs_ops = &mt7530_pcs_ops,
+ 		.sw_setup = mt7988_setup,
+ 		.phy_read_c22 = mt7531_ind_c22_phy_read,
++		.phy_write_c22 = mt7531_ind_c22_phy_write,
++		.phy_read_c45 = mt7531_ind_c45_phy_read,
++		.phy_write_c45 = mt7531_ind_c45_phy_write,
++		.mac_port_get_caps = en7581_mac_port_get_caps,
++	},
++	[ID_EN7523] = {
++		.id = ID_EN7523,
++		.pcs_ops = &mt7530_pcs_ops,
++		.sw_setup = mt7988_setup,
++		.phy_read_c22 = mt7531_ind_c22_phy_read,
+ 		.phy_write_c22 = mt7531_ind_c22_phy_write,
+ 		.phy_read_c45 = mt7531_ind_c45_phy_read,
+ 		.phy_write_c45 = mt7531_ind_c45_phy_write,
+--- a/drivers/net/dsa/mt7530.h
++++ b/drivers/net/dsa/mt7530.h
+@@ -21,7 +21,8 @@ enum mt753x_id {
+ 	ID_MT7988 = 3,
+ 	ID_EN7581 = 4,
+ 	ID_AN7583 = 5,
+ 	ID_EN7528 = 6,
++	ID_EN7523 = 7,
+ };
+ 
+ #define	NUM_TRGMII_CTRL			5
+@@ -68,32 +69,37 @@ enum mt753x_id {
+ #define MT753X_MIRROR_REG(id)		((id == ID_MT7531 || \
+ 					  id == ID_MT7988 || \
+ 					  id == ID_EN7581 || \
+-					  id == ID_AN7583) ? \
++					  id == ID_AN7583 || \
++					  id == ID_EN7523) ? \
+ 					 MT7531_CFC : MT753X_MFC)
+ 
+ #define MT753X_MIRROR_EN(id)		((id == ID_MT7531 || \
+ 					  id == ID_MT7988 || \
+-					  id == ID_EN7581) ? \
++					  id == ID_EN7581 || \
++					  id == ID_EN7523) ? \
+ 					 MT7531_MIRROR_EN : MT7530_MIRROR_EN)
+ 
+ #define MT753X_MIRROR_PORT_MASK(id)	((id == ID_MT7531 || \
+ 					  id == ID_MT7988 || \
+ 					  id == ID_EN7581 || \
+-					  id == ID_AN7583) ? \
++					  id == ID_AN7583 || \
++					  id == ID_EN7523) ? \
+ 					 MT7531_MIRROR_PORT_MASK : \
+ 					 MT7530_MIRROR_PORT_MASK)
+ 
+ #define MT753X_MIRROR_PORT_GET(id, val)	((id == ID_MT7531 || \
+ 					  id == ID_MT7988 || \
+ 					  id == ID_EN7581 || \
+-					  id == ID_AN7583) ? \
++					  id == ID_AN7583 || \
++					  id == ID_EN7523) ? \
+ 					 MT7531_MIRROR_PORT_GET(val) : \
+ 					 MT7530_MIRROR_PORT_GET(val))
+ 
+ #define MT753X_MIRROR_PORT_SET(id, val)	((id == ID_MT7531 || \
+ 					  id == ID_MT7988 || \
+ 					  id == ID_EN7581 || \
+-					  id == ID_AN7583) ? \
++					  id == ID_AN7583 || \
++					  id == ID_EN7523) ? \
+ 					 MT7531_MIRROR_PORT_SET(val) : \
+ 					 MT7530_MIRROR_PORT_SET(val))
+ 
+@@ -347,6 +353,8 @@ enum mt7530_vlan_port_acc_frm {
+ 
