--- /dev/null
+++ b/target/linux/airoha/en7523/base-files/etc/board.d/02_network
@@ -0,0 +1,36 @@
+#
+# Copyright (c) 2015 The Linux Foundation. All rights reserved.
+# Copyright (c) 2011-2015 OpenWrt.org
+#
+
+. /lib/functions/uci-defaults.sh
+. /lib/functions/system.sh
+
+en7523_setup_interfaces()
+{
+	local board="$1"
+
+	case "$board" in
+	airoha,en7523-evb)
+		ucidef_set_interfaces_lan_wan "eth1 eth2 eth3 eth4" "eth0"
+		;;
+	airoha,en7523-ax3000-router)
+		# DSA port mapping: eth1=p1=LAN4, eth2=p2=LAN3,
+		# eth3=p3=LAN2, eth4=p4=LAN1 (verified on hardware).
+		# eth0 is the DSA conduit (must NOT be in the bridge).
+		# LAN1 (eth4) is used as WAN port for router mode.
+		# LAN ports: eth1 eth2 eth3, WAN: eth4
+		ucidef_set_interfaces_lan_wan "eth1 eth2 eth3" "eth4"
+		;;
+	*)
+		echo "Unsupported hardware. Network interfaces not initialized"
+		;;
+	esac
+}
+
+board_config_update
+board=$(board_name)
+en7523_setup_interfaces $board
+board_config_flush
+
+exit 0
diff --git a/target/linux/airoha/en7523/base-files/etc/hotplug.d/ieee80211/15-wifi-led-mux b/target/linux/airoha/en7523/base-files/etc/hotplug.d/ieee80211/15-wifi-led-mux
new file mode 100644
index 0000000000..33f0678134
--- /dev/null
+++ b/target/linux/airoha/en7523/base-files/etc/hotplug.d/ieee80211/15-wifi-led-mux
@@ -0,0 +1,37 @@
+#!/bin/sh
+# Fix MT7916 WiFi LED GPIO mux on the EN7523 AX3000 router.
+#
+# The mt76 driver's mt7915_init_led_mux() writes to MT_LED_GPIO_MUX1
+# (0x70005054) via the PCIe MMIO bus, but this register is outside the
+# PCIe BAR mapping so the write silently fails.  The debugfs regidx/regval
+# interface uses a different access path that can reach this register.
+#
+# Without this fix the WiFi LEDs (2.4 GHz + 5 GHz) never light up because
+# the GPIO mux stays at 0x00000000.
+#
+# We set bits [31:24] = 0x33 which routes GPIO 14 and GPIO 15 on the
+# MT7916 to the LED controller — the same value the driver uses in its
+# DBDC branch.
+[ "$ACTION" = "add" ] || exit 0
+[ "$DEVICENAME" = "phy0" ] || exit 0
+
+DBG=/sys/kernel/debug/ieee80211/phy0/mt76
+
+# Wait for debugfs to appear
+i=0
+while [ ! -f "$DBG/regidx" ] && [ $i -lt 10 ]; do
+	sleep 1
+	i=$((i + 1))
+done
+[ -f "$DBG/regidx" ] || exit 0
+
+# Set MT_LED_GPIO_MUX1 (0x70005054) = 0x33000000
+echo 0x70005054 > "$DBG/regidx"
+echo 0x33000000 > "$DBG/regval"
+
+# The /etc/init.d/led script runs at boot (START=96) before the mt76
+# driver registers its LEDs, so the netdev triggers from the uci config
+# are never applied.  Reload the LED config now that the LEDs exist.
+/etc/init.d/led restart 2>/dev/null
+
+exit 0
diff --git a/target/linux/airoha/en7523/base-files/etc/hotplug.d/ieee80211/20-enable-wifi b/target/linux/airoha/en7523/base-files/etc/hotplug.d/ieee80211/20-enable-wifi
new file mode 100644
index 0000000000..1c0acf2d00
--- /dev/null
+++ b/target/linux/airoha/en7523/base-files/etc/hotplug.d/ieee80211/20-enable-wifi
@@ -0,0 +1,30 @@
+#!/bin/sh
+# Enable WiFi radios when detected on the EN7523 AX3000 router.
+# This runs AFTER 10-wifi-detect (which generates /etc/config/wireless via
+# /sbin/wifi config). The uci-defaults script (99-enable-wifi) may run before
+# the config exists, so this hotplug script handles the enable as a fallback.
+[ "$ACTION" = "add" ] || exit 0
+
+. /lib/functions.sh
+
+[ "$(board_name)" = "airoha,en7523-ax3000-router" ] || exit 0
+
+# Check if we already enabled WiFi (avoid running on every hotplug event)
+[ -f /tmp/.wifi-enabled ] && exit 0
+
+# Wait for /etc/config/wireless to exist (10-wifi-detect generates it)
+i=0
+while [ ! -f /etc/config/wireless ] && [ $i -lt 10 ]; do
+	sleep 1
+	i=$((i + 1))
+done
+[ -f /etc/config/wireless ] || exit 0
+
+uci -q set wireless.default_radio0.disabled=0
+uci -q set wireless.default_radio1.disabled=0
+uci -q commit wireless
+
+# Reload wireless to bring up the APs
+wifi reload
+
+touch /tmp/.wifi-enabled
diff --git a/target/linux/airoha/en7523/base-files/etc/uci-defaults/99-enable-wifi b/target/linux/airoha/en7523/base-files/etc/uci-defaults/99-enable-wifi
new file mode 100644
index 0000000000..3f7238573b
--- /dev/null
+++ b/target/linux/airoha/en7523/base-files/etc/uci-defaults/99-enable-wifi
@@ -0,0 +1,16 @@
+#!/bin/sh
+# Enable WiFi radios by default on the EN7523 AX3000 router.
+# uci-defaults run before WiFi modules finish loading, so /etc/config/wireless
+# may not exist yet. The uci -q commands silently fail if sections don't exist.
+# A hotplug.d/ieee80211/20-enable-wifi script handles the case where WiFi is
+# detected later.
+. /lib/functions.sh
+
+[ "$(board_name)" = "airoha,en7523-ax3000-router" ] || exit 0
+
+# Try to enable if config already exists (from a previous boot or generated early)
+uci -q set wireless.default_radio0.disabled=0
+uci -q set wireless.default_radio1.disabled=0
+uci -q commit wireless
+
+exit 0
diff --git a/target/linux/airoha/en7523/base-files/etc/uci-defaults/99-set-wifi-led-interval b/target/linux/airoha/en7523/base-files/etc/uci-defaults/99-set-wifi-led-interval
