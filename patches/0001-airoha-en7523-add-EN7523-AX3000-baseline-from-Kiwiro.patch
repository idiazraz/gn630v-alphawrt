+From 4094862f77b5507f1ea237d1a0489eb2f2d631c4 Mon Sep 17 00:00:00 2001
+From: Benjamin Larsson <noreply@localhost>
+Date: Sat, 13 Jun 2026 22:45:00 +0200
+Subject: [PATCH 047/131] net: pcs: airoha: en7523: init PON serdes
+ (SGMII/2500Base-X)
+
+The EN7523 PON PCS has phya=INVALID, so mainline never initialises the
+analog serdes PMA. The attached RTL8221B drives an SGMII (1.25G) serdes for
+a 1G copper link and a 2500Base-X (3.125G) serdes at 2.5G; without the
+matching analog PMA bring-up the serdes link never establishes and the
+XSI-AE MAC stays in local-fault with no traffic.
+
+Port the vendor sgmii_api_pon0_force_{sgmii,hsgmii}() PMA bring-up: pulse
+the serdes + XSI-MAC clock-domain reset, then program SSR3/WAN_CONF and the
+rate-specific PMA registers (the reset clears SSR3/WAN_CONF, so they must be
+written after it), saving/restoring the MAC global config across the reset.
+Dispatch the SGMII or 2500Base-X init from pcs_config() by interface for the
+PON port, so the link comes up at either copper speed.
+
+Signed-off-by: Benjamin Larsson <noreply@localhost>
+Signed-off-by: Matheus Sampaio Queiroga <noreply@localhost>
+---
+ drivers/net/pcs/airoha/pcs-en7523.c | 152 +++++++++++++++++++++++++++-
+ 1 file changed, 147 insertions(+), 5 deletions(-)
+
+--- a/drivers/net/pcs/airoha/pcs-en7523.c
++++ b/drivers/net/pcs/airoha/pcs-en7523.c
+@@ -37,6 +37,31 @@
+ 
+ #define EN7523_WAN_CONF_SGMII			0xe0000010
+ 
++/* PON serdes analog PMA (the PON PCS has phya=INVALID, so the analog block
++ * needs explicit init that the vendor performs in sgmii_api_pon0_force_sgmii).
++ */
++#define EN7523_SCU_RST_CFG			0x830
++#define EN7523_PON_PMA_BASE			0x1faf0000
++#define EN7523_PON_PMA_SIZE			0x5000
++#define EN7523_XSI_MAC_GLB_CFG			0x77fe2830
++#define PMA_SS_LCPLL_TDC_FLT_2			0x4130
++#define PMA_SS_LCPLL_TDC_FLT_3			0x4134
++#define PMA_SS_LCPLL_TDC_FLT_5			0x413c
++#define PMA_PON_SERDES_CTRL_0			0x4200
++#define PMA_PON_SERDES_CTRL_10			0x4228
++#define PMA_PON_SYS_CTRL_0			0x4300
++#define PMA_HG_RST_CTRL_0			0x4310
++#define PMA_HG_MODE_CTRL_0			0x4314
++#define PMA_HG_RG_CTRL_0			0x4318
++#define PMA_FRQ_CTRL_2				0x4364
++#define PMA_FRQ_CTRL_4				0x436c
++#define PMA_PON_RXFEDIG_CTRL_12			0x4530
++#define PMA_PON_DA_CTRL_2			0x4608
++#define PMA_PON_OSR_SEL_CTRL			0x4320
++#define PMA_RG_SSUSB_CDR_BYPASS			0x3028
++
++#define EN7523_WAN_CONF_HSGMII			0xe0000011
++
+ enum en7523_pcs_type {
+ 	EN7523_PCS_PON,
+ 	EN7523_PCS_PCIE,
+@@ -80,6 +105,7 @@ struct en7523_pcs {
+ 	const struct en7523_pcs_data *data;
+ 	struct en7523_pcs_port *ports;
+ 	struct regmap *scu;
++	void __iomem *pma;
+ 	struct reset_control_bulk_data rsts[2];
+ };
+ 
+@@ -136,6 +162,104 @@ static int en7523_pcs_init_regmap(struct
+ 	return PTR_ERR_OR_ZERO(*map);
+ }
+ 
++/*
++ * PON serdes SGMII (1.25G) analog init, ported from the vendor
++ * sgmii_api_pon0_force_sgmii(). Required because the PON PCS has
++ * phya=INVALID so mainline never initialises the analog PMA, and for a 1G
++ * copper link the RTL8221B uses an SGMII serdes (not 2500Base-X), which the
++ * uninitialised PMA cannot drive. SSR3/WAN_CONF are set by setup_scu().
++ */
++static void en7523_pcs_pon_serdes_sgmii_init(struct en7523_pcs_port *port)
++{
++	struct en7523_pcs *priv = port->priv;
++	void __iomem *pma = priv->pma;
++	u32 glb = EN7523_XSI_MAC_GLB_CFG;
++
++	if (!pma)
++		return;
++
++	/* The serdes + XSI-MAC clock-domain reset clears the MAC global
++	 * config; save and restore it like the vendor does.
++	 */
++	if (port->mac)
++		regmap_read(port->mac, 0x0, &glb);
++
++	regmap_write(priv->scu, EN7523_SCU_RST_CFG, 0x1);
++	regmap_write(priv->scu, EN7523_SCU_RST_CFG, 0x0);
++	usleep_range(10000, 11000);
++	regmap_write(priv->scu, EN7523_SCU_RST_CFG, 0x180);
++	regmap_write(priv->scu, EN7523_SCU_RST_CFG, 0x0);
++
++	regmap_update_bits(priv->scu, EN7523_SCU_SSR3,
++			   EN7523_SCU_SSR3_PON_MODE, EN7523_SCU_SSR3_PON_SGMII);
++	regmap_write(priv->scu, EN7523_SCU_WAN_CONF, EN7523_WAN_CONF_SGMII);
++
++	writel(0x64000000, pma + PMA_SS_LCPLL_TDC_FLT_2);
++	writel(0x00000220, pma + PMA_HG_RG_CTRL_0);
++	writel(0x00000103, pma + PMA_PON_SERDES_CTRL_10);
++	writel(0x00003003, pma + PMA_FRQ_CTRL_2);
++	writel(0x02710271, pma + PMA_FRQ_CTRL_4);
++	writel(0x18001722, pma + PMA_RG_SSUSB_CDR_BYPASS);
++	writel(0x0000003f, pma + PMA_HG_RST_CTRL_0);
++	writel(0x54101801, pma + PMA_PON_DA_CTRL_2);
++	writel(0x00380013, pma + PMA_PON_RXFEDIG_CTRL_12);
++	writel(0x00000001, pma + PMA_HG_MODE_CTRL_0);
++	writel(0x20000100, pma + PMA_SS_LCPLL_TDC_FLT_3);
++	writel(0x01010100, pma + PMA_SS_LCPLL_TDC_FLT_5);
++	writel(0x00100381, pma + PMA_PON_SERDES_CTRL_0);
++	writel(0x3f0003c0, pma + PMA_PON_SYS_CTRL_0);
++
++	if (port->mac)
++		regmap_write(port->mac, 0x0, glb);
++}
++
++/*
++ * PON serdes 2500Base-X (3.125G) analog init, ported from the vendor
++ * sgmii_api_pon0_force_hsgmii(). Used when the RTL8221B copper link is 2.5G,
++ * where its serdes runs 2500Base-X. Differs from the SGMII init in the
++ * frequency divider, system-control and OSR-select values.
++ */
++static void en7523_pcs_pon_serdes_2500basex_init(struct en7523_pcs_port *port)
++{
++	struct en7523_pcs *priv = port->priv;
++	void __iomem *pma = priv->pma;
++	u32 glb = EN7523_XSI_MAC_GLB_CFG;
++
++	if (!pma)
++		return;
++
++	if (port->mac)
++		regmap_read(port->mac, 0x0, &glb);
++
++	regmap_write(priv->scu, EN7523_SCU_RST_CFG, 0x1);
++	regmap_write(priv->scu, EN7523_SCU_RST_CFG, 0x0);
++	usleep_range(10000, 11000);
++	regmap_write(priv->scu, EN7523_SCU_RST_CFG, 0x180);
++	regmap_write(priv->scu, EN7523_SCU_RST_CFG, 0x0);
++
++	regmap_update_bits(priv->scu, EN7523_SCU_SSR3,
++			   EN7523_SCU_SSR3_PON_MODE, EN7523_SCU_SSR3_PON_SGMII);
++	regmap_write(priv->scu, EN7523_SCU_WAN_CONF, EN7523_WAN_CONF_HSGMII);
++
++	writel(0x64000000, pma + PMA_SS_LCPLL_TDC_FLT_2);
++	writel(0x00000103, pma + PMA_PON_SERDES_CTRL_10);
++	writel(0x00003003, pma + PMA_FRQ_CTRL_2);
++	writel(0x05600560, pma + PMA_FRQ_CTRL_4);
++	writel(0x18001722, pma + PMA_RG_SSUSB_CDR_BYPASS);
++	writel(0x0000003f, pma + PMA_HG_RST_CTRL_0);
++	writel(0x54101801, pma + PMA_PON_DA_CTRL_2);
++	writel(0x00380013, pma + PMA_PON_RXFEDIG_CTRL_12);
++	writel(0x00000011, pma + PMA_PON_OSR_SEL_CTRL);
++	writel(0x00000001, pma + PMA_HG_MODE_CTRL_0);
++	writel(0x20000100, pma + PMA_SS_LCPLL_TDC_FLT_3);
++	writel(0x01010100, pma + PMA_SS_LCPLL_TDC_FLT_5);
++	writel(0x00100381, pma + PMA_PON_SERDES_CTRL_0);
++	writel(0x240003c0, pma + PMA_PON_SYS_CTRL_0);
++
++	if (port->mac)
++		regmap_write(port->mac, 0x0, glb);
++}
++
+ static void en7523_pcs_setup_scu(struct en7523_pcs_port *port,
+ 					 phy_interface_t interface)
+ {
+@@ -143,11 +267,10 @@ static void en7523_pcs_setup_scu(struct
+ 	const struct en7523_pcs_res *res = &priv->data->res[port->index];
+ 
+ 	if (res->setup_pon) {
+-		regmap_update_bits(priv->scu, EN7523_SCU_SSR3,
+-				   EN7523_SCU_SSR3_PON_MODE,
+-				   EN7523_SCU_SSR3_PON_SGMII);
+-		regmap_write(priv->scu, EN7523_SCU_WAN_CONF,
+-			     EN7523_WAN_CONF_SGMII);
++		/* SSR3/WAN_CONF for the PON serdes are programmed inside the
++		 * PMA init, after the SCU clock-domain reset, since that reset
++		 * clears them.
++		 */
+ 		return;
+ 	}
+ 
+@@ -331,6 +454,17 @@ static int en7523_pcs_config(struct phyl
+ 
+ 	en7523_pcs_setup_scu(port, interface);
+ 
++	if (port->priv->data->res[port->index].setup_pon) {
++		/* The RTL8221B drives an SGMII serdes for a <=1G copper link
++		 * and a 2500Base-X serdes at 2.5G; bring up the matching PON
++		 * analog PMA so the serdes link establishes for either speed.
++		 */
++		if (interface == PHY_INTERFACE_MODE_2500BASEX)
++			en7523_pcs_pon_serdes_2500basex_init(port);
++		else if (interface == PHY_INTERFACE_MODE_SGMII)
++			en7523_pcs_pon_serdes_sgmii_init(port);
++	}
++
+ 	ret = en7523_pcs_set_phya_mode(port, interface);
+ 	if (ret)
+ 		return ret;
+@@ -520,6 +654,14 @@ static int en7523_pcs_probe(struct platf
+ 		return dev_err_probe(dev, PTR_ERR(priv->scu),
+ 				     "failed to get SCU regmap\n");
+ 
++	if (data->type == EN7523_PCS_PON) {
++		priv->pma = devm_ioremap(dev, EN7523_PON_PMA_BASE,
++					 EN7523_PON_PMA_SIZE);
++		if (!priv->pma)
++			return dev_err_probe(dev, -ENOMEM,
++					     "failed to map PON PMA\n");
++	}
++
+ 	priv->rsts[0].id = "mac";
+ 	priv->rsts[1].id = "phy";
+ 	ret = devm_reset_control_bulk_get_optional_exclusive(dev,
diff --git a/target/linux/airoha/patches-6.18/930-48-airoha_en7523_all-net-airoha-restrict-supported-interfaces-for-SGMII-p.patch b/target/linux/airoha/patches-6.18/930-48-airoha_en7523_all-net-airoha-restrict-supported-interfaces-for-SGMII-p.patch
new file mode 100644
index 0000000000..3dbaf88268
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/930-48-airoha_en7523_all-net-airoha-restrict-supported-interfaces-for-SGMII-p.patch
@@ -0,0 +1,48 @@
+From 2666f5be73a7b1b06c8e02c923c69abf0b92c6bf Mon Sep 17 00:00:00 2001
+From: Benjamin Larsson <noreply@localhost>
+Date: Sat, 13 Jun 2026 21:31:00 +0200
+Subject: [PATCH 048/131] net: airoha: restrict supported interfaces for SGMII
+ ports
+
+Only advertise the higher-rate PHY interfaces (2500BASEX, 10GBASER,
+USXGMII) when the GDM port is actually configured for them. An RTL8221B
+attached in SGMII mode (1G copper) otherwise sees 2500BASEX in
+host_interfaces and forces its serdes to 2500Base-X rate-match, which never
+links against an SGMII PCS.
+
+Signed-off-by: Benjamin Larsson <noreply@localhost>
+Signed-off-by: Matheus Sampaio Queiroga <noreply@localhost>
+---
+ drivers/net/ethernet/airoha/airoha_eth.c | 21 +++++++++++++++------
+ 1 file changed, 15 insertions(+), 6 deletions(-)
+
+--- a/drivers/net/ethernet/airoha/airoha_eth.c
++++ b/drivers/net/ethernet/airoha/airoha_eth.c
+@@ -4006,12 +4006,21 @@ static int airoha_setup_phylink(struct n
+ 			  config->supported_interfaces);
+ 		__set_bit(PHY_INTERFACE_MODE_1000BASEX,
+ 			  config->supported_interfaces);
+-		__set_bit(PHY_INTERFACE_MODE_2500BASEX,
+-			  config->supported_interfaces);
+-		__set_bit(PHY_INTERFACE_MODE_10GBASER,
+-			  config->supported_interfaces);
+-		__set_bit(PHY_INTERFACE_MODE_USXGMII,
+-			  config->supported_interfaces);
++		/*
++		 * Only advertise the higher-rate interfaces when the port is actually
++		 * configured for them. An RTL8221B attached in SGMII mode (1G copper)
++		 * otherwise sees 2500BASEX in host_interfaces and forces its serdes to
++		 * 2500Base-X rate-match, which never links against an SGMII PCS.
++		 */
++		if (phy_mode != PHY_INTERFACE_MODE_SGMII &&
++		    phy_mode != PHY_INTERFACE_MODE_1000BASEX) {
++			__set_bit(PHY_INTERFACE_MODE_2500BASEX,
++				  dev->phylink_config.supported_interfaces);
++			__set_bit(PHY_INTERFACE_MODE_10GBASER,
++				  dev->phylink_config.supported_interfaces);
++			__set_bit(PHY_INTERFACE_MODE_USXGMII,
++				  dev->phylink_config.supported_interfaces);
++		}
+ 
+ 		phy_interface_copy(config->pcs_interfaces,
+ 				   config->supported_interfaces);
diff --git a/target/linux/airoha/patches-6.18/930-49-airoha_en7523_all-net-pcs-airoha-en7523-init-USB-PCIe-XSI-serdes.patch b/target/linux/airoha/patches-6.18/930-49-airoha_en7523_all-net-pcs-airoha-en7523-init-USB-PCIe-XSI-serdes.patch
new file mode 100644
index 0000000000..67214b2fe4
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/930-49-airoha_en7523_all-net-pcs-airoha-en7523-init-USB-PCIe-XSI-serdes.patch
@@ -0,0 +1,77 @@
+From 6ce5668745311f534aefe4833214c518bd6386ad Mon Sep 17 00:00:00 2001
+From: Benjamin Larsson <noreply@localhost>
+Date: Sat, 13 Jun 2026 23:55:00 +0200
+Subject: [PATCH 049/131] net: pcs: airoha: en7523: init USB/PCIe XSI serdes
+
+The USB and PCIe serdes (GDM3 external ports) have a real phya so their
+analog is handled by set_phya_mode(), but mainline never programs the
+rate-adapt/AN/PCS-control values nor pulses their clock-domain reset, so the
+serdes link to the SoC never establishes. Port the vendor
+sgmii_api_{usb0,pcie0,pcie1}_force_hsgmii() bring-up: a shared helper writes
+RATE_ADAPT_CTRL_0/AN0/CTROL_6 and pulses RST_CFG with the per-port reset bits
+(PCIe0 0x12000, PCIe1 0x24000, USB 0x48000), saving/restoring the MAC global
+config across the reset. Dispatch it by PCS type in the 2500Base-X path.
+
+Signed-off-by: Benjamin Larsson <noreply@localhost>
+Signed-off-by: Matheus Sampaio Queiroga <noreply@localhost>
+---
+ drivers/net/pcs/airoha/pcs-en7523.c | 41 +++++++++++++++++++++++++++++
+ 1 file changed, 41 insertions(+)
+
+--- a/drivers/net/pcs/airoha/pcs-en7523.c
++++ b/drivers/net/pcs/airoha/pcs-en7523.c
+@@ -260,6 +260,34 @@ static void en7523_pcs_pon_serdes_2500ba
+ 		regmap_write(port->mac, 0x0, glb);
+ }
+ 
++/*
++ * XSI serdes (USB / PCIe0 / PCIe1) init, ported from the vendor
++ * sgmii_api_{usb0,pcie0,pcie1}_force_hsgmii(). These serdes have a real phya
++ * (handled by set_phya_mode()), so unlike the PON serdes no analog PMA poke is
++ * needed -- only the rate-adapt/AN/PCS-control values and a per-port
++ * clock-domain reset (RST_CFG bits, saving/restoring the MAC global config),
++ * which mainline otherwise omits, leaving the serdes link down. The reset bits
++ * differ per port: PCIe0=0x12000, PCIe1=0x24000, USB=0x48000.
++ */
++static void en7523_pcs_xsi_serdes_init(struct en7523_pcs_port *port,
++				       u32 rst_bits)
++{
++	struct en7523_pcs *priv = port->priv;
++	u32 glb = EN7523_XSI_MAC_GLB_CFG, rst;
++
++	regmap_write(port->ra, AIROHA_PCS_HSGMII_RATE_ADAPT_CTRL_0, 0x0c000c11);
++	regmap_write(port->an, AIROHA_PCS_HSGMII_AN_SGMII_REG_AN_0, 0x00000140);
++	regmap_write(port->pcs2, AIROHA_PCS_HSGMII_PCS_CTROL_6, 0x3);
++
++	if (port->mac)
++		regmap_read(port->mac, 0x0, &glb);
++	regmap_read(priv->scu, EN7523_SCU_RST_CFG, &rst);
++	regmap_write(priv->scu, EN7523_SCU_RST_CFG, rst | rst_bits);
++	regmap_write(priv->scu, EN7523_SCU_RST_CFG, rst & ~rst_bits);
++	if (port->mac)
++		regmap_write(port->mac, 0x0, glb);
++}
++
+ static void en7523_pcs_setup_scu(struct en7523_pcs_port *port,
+ 					 phy_interface_t interface)
+ {
+@@ -490,6 +518,19 @@ static int en7523_pcs_config(struct phyl
+ 				   AIROHA_PCS_HSGMII_PCS_FORCE_RATEADAPT |
+ 				   AIROHA_PCS_HSGMII_PCS_FORCE_RATEADAPT_VAL,
+ 				   0);
++
++		switch (port->priv->data->type) {
++		case EN7523_PCS_USB:
++			en7523_pcs_xsi_serdes_init(port, 0x48000);
++			break;
++		case EN7523_PCS_PCIE:
++			en7523_pcs_xsi_serdes_init(port,
++						   port->index ? 0x24000 : 0x12000);
++			break;
++		default:
++			break;
++		}
++
+ 		port->interface = interface;
+ 		return 0;
+ 	}
diff --git a/target/linux/airoha/patches-6.18/930-50-airoha_en7523_all-net-airoha-en7523-support-the-GDM3-USB-serdes-port.patch b/target/linux/airoha/patches-6.18/930-50-airoha_en7523_all-net-airoha-en7523-support-the-GDM3-USB-serdes-port.patch
new file mode 100644
index 0000000000..63367a3dab
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/930-50-airoha_en7523_all-net-airoha-en7523-support-the-GDM3-USB-serdes-port.patch
@@ -0,0 +1,59 @@
+From 849d0f8dc54bbed987dc9e2f786ed151ef05d468 Mon Sep 17 00:00:00 2001
+From: Benjamin Larsson <noreply@localhost>
+Date: Sat, 13 Jun 2026 23:56:00 +0200
+Subject: [PATCH 050/131] net: airoha: en7523: support the GDM3 USB serdes port
+
+Wire up the EN7523 GDM3 USB serdes port (a third RTL8221B on the bitbang
+MDIO bus). The USB port is the third device on GDM3, so grow the per-port
+device array to 3, and fix the USB source-port plumbing to match the DT
+eth-port reg (6): get_sport()/get_vip_port() map USB at nbq==6, and the RX
+get_dev_from_sport() maps the USB source port to device index 2. PCIe0/PCIe1
+(dev 0/1) are unchanged.
+
+Signed-off-by: Benjamin Larsson <noreply@localhost>
+Signed-off-by: Matheus Sampaio Queiroga <noreply@localhost>
+---
+ drivers/net/ethernet/airoha/airoha_eth.c | 6 +++---
+ drivers/net/ethernet/airoha/airoha_eth.h | 2 +-
+ 2 files changed, 4 insertions(+), 4 deletions(-)
+
+--- a/drivers/net/ethernet/airoha/airoha_eth.c
++++ b/drivers/net/ethernet/airoha/airoha_eth.c
+@@ -4399,7 +4399,7 @@ static int airoha_en7523_get_sport(struc
+ 			return HSGMII_LAN_7523_PCIE0_SRCPORT;
+ 		if (nbq == 5)
+ 			return HSGMII_LAN_7523_PCIE1_SRCPORT;
+-		if (nbq == 1)
++		if (nbq == 6)
+ 			return HSGMII_LAN_7523_USB_SRCPORT;
+ 		if (!nbq)
+ 			return HSGMII_LAN_7523_ETH_SRCPORT;
+@@ -4420,7 +4420,7 @@ static u32 airoha_en7523_get_vip_port(st
+ 			return XSI_PCIE1_VIP_PORT_MASK;
+ 		if (!nbq)
+ 			return XSI_ETH_VIP_PORT_MASK;
+-		if (nbq == 1)
++		if (nbq == 6)
+ 			return XSI_USB_VIP_PORT_MASK;
+ 		break;
+ 	default:
+@@ -4451,7 +4451,7 @@ static int airoha_en7523_get_dev_from_sp
+ 		*port = 2; /* GDM3 */
+ 		break;
+ 	case HSGMII_LAN_7523_USB_SRCPORT:
+-		*dev = 1;
++		*dev = 2;
+ 		fallthrough;
+ 	case HSGMII_LAN_7523_ETH_SRCPORT:
+ 		*port = 2; /* GDM3 */
+--- a/drivers/net/ethernet/airoha/airoha_eth.h
++++ b/drivers/net/ethernet/airoha/airoha_eth.h
+@@ -17,7 +17,7 @@
+ #include <net/dsa.h>
+ 
+ #define AIROHA_MAX_NUM_GDM_PORTS	4
+-#define AIROHA_MAX_NUM_GDM_DEVS		2
++#define AIROHA_MAX_NUM_GDM_DEVS		3
+ #define AIROHA_MAX_NUM_QDMA		2
+ #define AIROHA_MAX_DSA_PORTS		7
+ #define AIROHA_MAX_NUM_RSTS		3
diff --git a/target/linux/airoha/patches-6.18/930-51-airoha_en7523_all-net-pcs-airoha-en7523-fix-PON-1000Base-X-rate-setup.patch b/target/linux/airoha/patches-6.18/930-51-airoha_en7523_all-net-pcs-airoha-en7523-fix-PON-1000Base-X-rate-setup.patch
new file mode 100644
index 0000000000..644f6ee09a
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/930-51-airoha_en7523_all-net-pcs-airoha-en7523-fix-PON-1000Base-X-rate-setup.patch
@@ -0,0 +1,286 @@
+From f3e691a1a47a9b14f3caeb2aba84fbd9db0cba1d Mon Sep 17 00:00:00 2001
+From: Matheus Sampaio Queiroga <noreply@localhost>
+Date: Sun, 14 Jun 2026 12:00:50 -0300
+Subject: [PATCH 051/131] net: pcs: airoha: en7523: fix PON 1000Base-X rate
+ setup
+
+The EN7523 PON SerDes SGMII-rate PMA setup is required not only for
+PHY_INTERFACE_MODE_SGMII, but also for PHY_INTERFACE_MODE_1000BASEX. Some
+SFP/copper modules are resolved by phylink as 1000Base-X while still using the
+same 1.25G line rate on the host SerDes side. Without running the SGMII-rate
+PON PMA sequence in that mode, the link can be reported as up while no traffic
+reaches the XSI/GDM2 path.
+
+Also keep the PON PCS link_up() path active when in-band negotiation is
+enabled. Unlike the other EN7523 PCS instances, the PON path still needs
+link_up() to apply the resolved speed to the PCS rate-adapt/force-speed state.
+
+This fixes the case where the SFP reports 1G/full link but the EN7523 XSI/GDM2
+RX counters stay at zero.
+
+Signed-off-by: Matheus Sampaio Queiroga <noreply@localhost>
+---
+ drivers/net/pcs/airoha/pcs-en7523.c | 120 ++++++++++++++++++----------
+ 1 file changed, 78 insertions(+), 42 deletions(-)
+
+--- a/drivers/net/pcs/airoha/pcs-en7523.c
++++ b/drivers/net/pcs/airoha/pcs-en7523.c
+@@ -27,7 +27,6 @@
+ 
+ #define EN7523_SCU_SSR3				0x94
+ #define EN7523_SCU_WAN_CONF			0x70
+-#define EN7523_PCS_INVALID_RES			UINT_MAX
+ 
+ #define EN7523_SCU_SSR3_PCIE0_HSGMII_DIS	BIT(31)
+ #define EN7523_SCU_SSR3_PCIE1_HSGMII_DIS	BIT(30)
+@@ -69,12 +68,12 @@ enum en7523_pcs_type {
+ };
+ 
+ struct en7523_pcs_res {
+-	unsigned int mac;
+-	unsigned int pcs1;
+-	unsigned int pcs2;
+-	unsigned int an;
+-	unsigned int ra;
+-	unsigned int phya;
++	const char *mac;
++	const char *pcs1;
++	const char *pcs2;
++	const char *an;
++	const char *ra;
++	const char *phya;
+ 	u32 ssr3_clear;
+ 	bool setup_pon;
+ };
+@@ -134,9 +133,10 @@ static int en7523_pcs_reset(struct en752
+ }
+ 
+ static int en7523_pcs_init_regmap(struct platform_device *pdev,
+-					  unsigned int index, struct regmap **map)
++					  const char *regname, struct regmap **map)
+ {
+ 	struct regmap_config config = {
++		.name = regname,
+ 		.reg_bits = 32,
+ 		.val_bits = 32,
+ 		.reg_stride = 4,
+@@ -144,15 +144,10 @@ static int en7523_pcs_init_regmap(struct
+ 	struct resource *res;
+ 	void __iomem *base;
+ 
+-	if (index == EN7523_PCS_INVALID_RES) {
+-		*map = NULL;
+-		return 0;
+-	}
+-
+-	res = platform_get_resource(pdev, IORESOURCE_MEM, index);
++	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, regname);
+ 	if (!res)
+ 		return dev_err_probe(&pdev->dev, -EINVAL,
+-				     "missing reg resource %u\n", index);
++				     "missing reg resource %s\n", regname);
+ 
+ 	base = devm_ioremap_resource(&pdev->dev, res);
+ 	if (IS_ERR(base))
+@@ -242,19 +237,25 @@ static void en7523_pcs_pon_serdes_2500ba
+ 	regmap_write(priv->scu, EN7523_SCU_WAN_CONF, EN7523_WAN_CONF_HSGMII);
+ 
+ 	writel(0x64000000, pma + PMA_SS_LCPLL_TDC_FLT_2);
++	if (port->an)
++		regmap_write(port->an, AIROHA_PCS_HSGMII_AN_SGMII_REG_AN_0,
++			     0x00000140);
++
+ 	writel(0x00000103, pma + PMA_PON_SERDES_CTRL_10);
+ 	writel(0x00003003, pma + PMA_FRQ_CTRL_2);
+-	writel(0x05600560, pma + PMA_FRQ_CTRL_4);
++	writel(0x15601560, pma + PMA_FRQ_CTRL_4);
+ 	writel(0x18001722, pma + PMA_RG_SSUSB_CDR_BYPASS);
++	writel(0x250003c0, pma + PMA_PON_SYS_CTRL_0);
+ 	writel(0x0000003f, pma + PMA_HG_RST_CTRL_0);
+ 	writel(0x54101801, pma + PMA_PON_DA_CTRL_2);
+ 	writel(0x00380013, pma + PMA_PON_RXFEDIG_CTRL_12);
+ 	writel(0x00000011, pma + PMA_PON_OSR_SEL_CTRL);
+ 	writel(0x00000001, pma + PMA_HG_MODE_CTRL_0);
++	writel(0x240003c0, pma + PMA_PON_SYS_CTRL_0);
++	writel(0x00010100, pma + PMA_SS_LCPLL_TDC_FLT_5);
+ 	writel(0x20000100, pma + PMA_SS_LCPLL_TDC_FLT_3);
+ 	writel(0x01010100, pma + PMA_SS_LCPLL_TDC_FLT_5);
+ 	writel(0x00100381, pma + PMA_PON_SERDES_CTRL_0);
+-	writel(0x240003c0, pma + PMA_PON_SYS_CTRL_0);
+ 
+ 	if (port->mac)
+ 		regmap_write(port->mac, 0x0, glb);
+@@ -337,21 +338,23 @@ static void en7523_pcs_get_state_sgmii(s
+ 				       unsigned int neg_mode,
+ 				       struct phylink_link_state *state)
+ {
+-	u32 bmsr, lpa;
+-
+-	regmap_read(port->an, AIROHA_PCS_HSGMII_AN_SGMII_REG_AN_1, &bmsr);
+-	regmap_read(port->an, AIROHA_PCS_HSGMII_AN_SGMII_REG_AN_5, &lpa);
++	u32 raw_bmsr, raw_lpa, bmsr, lpa;
+ 
+-	bmsr &= AIROHA_PCS_HSGMII_AN_SGMII_AN_COMPLETE |
+-		AIROHA_PCS_HSGMII_AN_SGMII_REMOTE_FAULT |
+-		AIROHA_PCS_HSGMII_AN_SGMII_AN_ABILITY |
+-		AIROHA_PCS_HSGMII_AN_SGMII_LINK_STATUS;
+-	lpa &= AIROHA_PCS_HSGMII_AN_SGMII_PARTNER_ABILITY;
++	regmap_read(port->an, AIROHA_PCS_HSGMII_AN_SGMII_REG_AN_1,
++		    &raw_bmsr);
++	regmap_read(port->an, AIROHA_PCS_HSGMII_AN_SGMII_REG_AN_5,
++		    &raw_lpa);
++
++	bmsr = raw_bmsr & (AIROHA_PCS_HSGMII_AN_SGMII_AN_COMPLETE |
++			    AIROHA_PCS_HSGMII_AN_SGMII_REMOTE_FAULT |
++			    AIROHA_PCS_HSGMII_AN_SGMII_AN_ABILITY |
++			    AIROHA_PCS_HSGMII_AN_SGMII_LINK_STATUS);
++	lpa = raw_lpa & AIROHA_PCS_HSGMII_AN_SGMII_PARTNER_ABILITY;
+ 
+ 	phylink_mii_c22_pcs_decode_state(state, neg_mode, bmsr, lpa);
+ }
+ 
+-static void en7523_pcs_get_state_2500basex(struct en7523_pcs_port *port,
++static void en7523_pcs_get_state_hsgmii(struct en7523_pcs_port *port,
+ 					   struct phylink_link_state *state)
+ {
+ 	u32 pcs_sts = 0, bmsr = 0;
+@@ -363,8 +366,10 @@ static void en7523_pcs_get_state_2500bas
+ 		      !!(bmsr & AIROHA_PCS_HSGMII_AN_SGMII_LINK_STATUS);
+ 	state->an_complete = !!(pcs_sts & AIROHA_PCS_HSGMII_PCS_AN_DONE) ||
+ 			     !!(bmsr & AIROHA_PCS_HSGMII_AN_SGMII_AN_COMPLETE);
+-	state->speed = SPEED_2500;
+-	state->duplex = DUPLEX_FULL;
++	if (state->link) {
++		state->speed = SPEED_2500;
++		state->duplex = DUPLEX_FULL;
++	}
+ }
+ 
+ static void en7523_pcs_get_state(struct phylink_pcs *pcs,
+@@ -379,12 +384,17 @@ static void en7523_pcs_get_state(struct
+ 		en7523_pcs_get_state_sgmii(port, neg_mode, state);
+ 		break;
+ 	case PHY_INTERFACE_MODE_2500BASEX:
+-		en7523_pcs_get_state_2500basex(port, state);
++		en7523_pcs_get_state_hsgmii(port, state);
+ 		break;
+ 	default:
+ 		state->link = false;
+ 		break;
+ 	}
++
++	dev_dbg(port->priv->dev,
++		"get_state: type=%u port=%u interface=%s link=%d an_complete=%d speed=%d duplex=%d\n",
++		port->priv->data->type, port->index, phy_modes(state->interface),
++		state->link, state->an_complete, state->speed, state->duplex);
+ }
+ 
+ static int en7523_pcs_config_an(struct en7523_pcs_port *port,
+@@ -489,7 +499,8 @@ static int en7523_pcs_config(struct phyl
+ 		 */
+ 		if (interface == PHY_INTERFACE_MODE_2500BASEX)
+ 			en7523_pcs_pon_serdes_2500basex_init(port);
+-		else if (interface == PHY_INTERFACE_MODE_SGMII)
++		else if (interface == PHY_INTERFACE_MODE_SGMII ||
++			 interface == PHY_INTERFACE_MODE_1000BASEX)
+ 			en7523_pcs_pon_serdes_sgmii_init(port);
+ 	}
+ 
+@@ -574,7 +585,8 @@ static void en7523_pcs_link_up(struct ph
+ 	u32 force_speed = 0, rate_adapt = 0, speed_mode = 0, clk_mode = 0;
+ 	u32 ra_ctrl;
+ 
+-	if (neg_mode == PHYLINK_PCS_NEG_INBAND_ENABLED)
++	if (neg_mode == PHYLINK_PCS_NEG_INBAND_ENABLED &&
++	    port->priv->data->type != EN7523_PCS_PON)
+ 		return;
+ 
+ 	if (interface == PHY_INTERFACE_MODE_2500BASEX) {
+@@ -735,19 +747,22 @@ static int en7523_pcs_probe(struct platf
+ 		ret = en7523_pcs_init_regmap(pdev, res->mac, &port->mac);
+ 		if (ret)
+ 			return ret;
++
+ 		ret = en7523_pcs_init_regmap(pdev, res->pcs1, &port->pcs1);
+ 		if (ret)
+ 			return ret;
++
+ 		ret = en7523_pcs_init_regmap(pdev, res->pcs2, &port->pcs2);
+ 		if (ret)
+ 			return ret;
++
+ 		ret = en7523_pcs_init_regmap(pdev, res->an, &port->an);
+ 		if (ret)
+ 			return ret;
++
+ 		ret = en7523_pcs_init_regmap(pdev, res->ra, &port->ra);
