diff --git a/target/linux/airoha/patches-6.18/930-44-airoha_en7523_all-net-dsa-mt7530-Enable-LED-controller-for-EN7523.patch b/target/linux/airoha/patches-6.18/930-44-airoha_en7523_all-net-dsa-mt7530-Enable-LED-controller-for-EN7523.patch
new file mode 100644
index 0000000000..5a11a24f95
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/930-44-airoha_en7523_all-net-dsa-mt7530-Enable-LED-controller-for-EN7523.patch
@@ -0,0 +1,84 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: EN7523 port <noreply@localhost>
+Date: Mon, 1 Sep 2026 12:00:00 +0000
+Subject: [PATCH] net: dsa: mt7530: Configure PHY LED mode for EN7523
+
+Configure MediaTek GPHY LED registers (MMD VEND2 0x24-0x27) after
+PHY reset on EN7523. The PHY reset clears the bootloader LED config.
+LED0: on when link up, LED0 blink: TX/RX activity at all speeds.
+Use indirect switch register access (mt7531_ind_c45_phy_write) since
+EN7523 PHYs are accessed through the switch, not external MDIO.
+Also restore SCU GPIO_2ND_I2C_MODE after switch reset as safety net.
+
+Signed-off-by: EN7523 port <noreply@localhost>
+
+--- a/drivers/net/dsa/mt7530.c
++++ b/drivers/net/dsa/mt7530.c
+@@ -3232,6 +3232,22 @@
+ 	reset_control_deassert(priv->rstc);
+ 	usleep_range(20, 50);
+ 
++	/* Restore SCU GPIO_2ND_I2C_MODE (0x0210) after switch reset.
++	 * The bootloader sets this to 0x2a8 for PHY LED mode on LAN LED pins.
++	 * The switch reset doesn't actually clear it, but restore as safety net.
++	 */
++	if (priv->id == ID_EN7523) {
++		struct regmap *scu = syscon_regmap_lookup_by_compatible("airoha,en7523-scu");
++		if (!IS_ERR(scu)) {
++			u32 val;
++			regmap_read(scu, 0x0210, &val);
++			if (val != 0x2a8) {
++				regmap_write(scu, 0x0210, 0x2a8);
++				dev_info(priv->dev, "EN7523: SCU 0x0210 restored 0x%x->0x2a8\n", val);
++			}
++		}
++	}
++
+ 	/* AN7583 require additional tweak to CONN_CFG */
+ 	if (priv->id == ID_AN7583)
+ 		mt7530_rmw(priv, AN7583_GEPHY_CONN_CFG,
+@@ -3255,6 +3271,44 @@
+ 	/* Reset the switch PHYs */
+ 	mt7530_write(priv, MT7530_SYS_CTRL, SYS_CTRL_PHY_RST);
+ 
++	/* Configure PHY LED mode for EN7523 internal PHYs.
++	 * The PHY reset clears the LED configuration. The PHYs (MDIO 9-12)
++	 * use MediaTek GPHY LED registers in MMD VEND2:
++	 *   0x24 = LED0_ON_CTRL, 0x25 = LED0_BLINK_CTRL
++	 *   0x26 = LED1_ON_CTRL, 0x27 = LED1_BLINK_CTRL
++	 * LED0: on when link is up (any speed), active-low polarity
++	 * LED0 blink: TX/RX activity at all speeds
++	 * Bit 14 = polarity, Bit 15 = enable
++	 * Use mt7531_ind_c45_phy_write (indirect switch register access)
++	 * because the EN7523 PHYs are accessed through the switch, not the
++	 * external MDIO bus.
++	 */
++	if (priv->id == ID_EN7523) {
++		int i;
++		u16 led0_on = BIT(0) | BIT(1) | BIT(2) | BIT(14) | BIT(15);
++		u16 led0_blink = BIT(0) | BIT(1) | BIT(2) | BIT(3) | BIT(4) | BIT(5);
++		u16 led1_on = BIT(14) | BIT(15);
++		u16 led1_blink = 0;
++
++		for (i = 9; i <= 12; i++) {
++			mt7531_ind_c45_phy_write(priv, i, MDIO_MMD_VEND2, 0x24, led0_on);
++			mt7531_ind_c45_phy_write(priv, i, MDIO_MMD_VEND2, 0x25, led0_blink);
++			mt7531_ind_c45_phy_write(priv, i, MDIO_MMD_VEND2, 0x26, led1_on);
++			mt7531_ind_c45_phy_write(priv, i, MDIO_MMD_VEND2, 0x27, led1_blink);
++		}
++		/* Debug: read back LED registers for PHY 9 */
++		{
++			int r0, r1, r2, r3;
++			r0 = mt7531_ind_c45_phy_read(priv, 9, MDIO_MMD_VEND2, 0x24);
++			r1 = mt7531_ind_c45_phy_read(priv, 9, MDIO_MMD_VEND2, 0x25);
++			r2 = mt7531_ind_c45_phy_read(priv, 9, MDIO_MMD_VEND2, 0x26);
++			r3 = mt7531_ind_c45_phy_read(priv, 9, MDIO_MMD_VEND2, 0x27);
++			dev_info(priv->dev, "EN7523: PHY9 LED readback: 0x24=0x%x 0x25=0x%x 0x26=0x%x 0x27=0x%x\n",
++				 r0, r1, r2, r3);
++		}
++		dev_info(priv->dev, "EN7523: PHY LED mode configured\n");
++	}
++
+ 	return mt7531_setup_common(ds);
+ }
+ 
