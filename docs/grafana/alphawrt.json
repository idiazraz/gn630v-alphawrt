{
 "__inputs": [
  {
   "name": "DS_PROMETHEUS",
   "label": "Prometheus",
   "type": "datasource",
   "pluginId": "prometheus",
   "pluginName": "Prometheus"
  }
 ],
 "title": "AlphaWRT",
 "uid": "alphawrt",
 "tags": [
  "alphawrt",
  "openwrt",
  "gpon"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "instance",
    "label": "Box",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${DS_PROMETHEUS}"
    },
    "query": "label_values(alphawrt_pon_state, instance)",
    "refresh": 2,
    "includeAll": false
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "title": "Fibre Rx",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "alphawrt_rx_dbm{instance=~\"$instance\"}",
     "legendFormat": "Rx",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "dBm",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": -27
       },
       {
        "color": "green",
        "value": -25
       },
       {
        "color": "orange",
        "value": -10
       },
       {
        "color": "red",
        "value": -8
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 2,
   "title": "Line state",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "alphawrt_pon_state{instance=~\"$instance\"}",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "5": {
         "text": "O5 registered",
         "color": "green"
        },
        "1": {
         "text": "O1 no light",
         "color": "red"
        },
        "7": {
         "text": "O7 disabled by ISP",
         "color": "red"
        }
       }
      },
      {
       "type": "range",
       "options": {
        "from": 2,
        "to": 4,
        "result": {
         "text": "Registering",
         "color": "orange"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 3,
   "title": "PPPoE uptime",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "alphawrt_wan_uptime_seconds{instance=~\"$instance\"}",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "title": "Box uptime",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_time_seconds{instance=~\"$instance\"} - node_boot_time_seconds{instance=~\"$instance\"}",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 5,
   "title": "Memory used",
   "type": "gauge",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - node_memory_MemAvailable_bytes{instance=~\"$instance\"} / node_memory_MemTotal_bytes{instance=~\"$instance\"}",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.6
       },
       {
        "color": "red",
        "value": 0.65
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "title": "Optics temperature",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "alphawrt_optics_temp_celsius{instance=~\"$instance\"}",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "celsius"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "title": "CPU per core",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - sum by (cpu) (rate(node_cpu_seconds_total{instance=~\"$instance\",mode=~\"idle|iowait\"}[$__rate_interval])) / sum by (cpu) (rate(node_cpu_seconds_total{instance=~\"$instance\"}[$__rate_interval]))",
     "legendFormat": "{{cpu}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "title": "Load",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_load1{instance=~\"$instance\"}",
     "legendFormat": "1 min",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    },
    {
     "refId": "B",
     "expr": "node_load5{instance=~\"$instance\"}",
     "legendFormat": "5 min",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    },
    {
     "refId": "C",
     "expr": "node_load15{instance=~\"$instance\"}",
     "legendFormat": "15 min",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 9,
   "title": "Memory",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 18,
    "y": 4,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_memory_MemTotal_bytes{instance=~\"$instance\"} - node_memory_MemAvailable_bytes{instance=~\"$instance\"}",
     "legendFormat": "used",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    },
    {
     "refId": "B",
     "expr": "node_memory_MemAvailable_bytes{instance=~\"$instance\"}",
     "legendFormat": "available",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 10,
   "title": "Fibre light",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "alphawrt_rx_dbm{instance=~\"$instance\"}",
     "legendFormat": "Rx",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    },
    {
     "refId": "B",
     "expr": "alphawrt_tx_dbm{instance=~\"$instance\"}",
     "legendFormat": "Tx",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    },
    {
     "refId": "C",
     "expr": "alphawrt_olt_threshold{instance=~\"$instance\",type=\"rx_low_dbm\"}",
     "legendFormat": "Rx low limit (OLT)",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "dBm"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 11,
   "title": "Line errors",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "increase(alphawrt_line_errors_total{instance=~\"$instance\"}[$__rate_interval]) > 0",
     "legendFormat": "{{type}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 12,
   "title": "Network",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(node_network_receive_bytes_total{instance=~\"$instance\",device=~\"pon0.*|lan[1-4]|br-.*|phy.*|wl.*\"}[$__rate_interval]) * 8",
     "legendFormat": "{{device}} in",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    },
    {
     "refId": "B",
     "expr": "-rate(node_network_transmit_bytes_total{instance=~\"$instance\",device=~\"pon0.*|lan[1-4]|br-.*|phy.*|wl.*\"}[$__rate_interval]) * 8",
     "legendFormat": "{{device}} out",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps"
    },
    "overrides": []
   },
   "options": {}
  }
 ]
}