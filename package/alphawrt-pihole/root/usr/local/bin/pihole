#!/bin/sh
# `pihole` for AlphaWRT, in place of upstream's bash script (which needs
# bash, curl and GNU grep). FTL runs `pihole -g` for "Update gravity"; the
# rest is what the box needs:
#   -g             rebuild gravity from the enabled adlists
#   ensure         rebuild gravity if it is empty (boot, WAN up)
#   daily          rebuild gravity if Pi-hole is on (cron)
#   reloadlists    make FTL re-read lists and domains after an edit
#   apply          uci pihole.main -> dnsmasq port, FTL settings, presets,
#                  DNS enforcement, service
#   prepare        create the gravity database in RAM (init script)
#   save           keep groups/lists/domains/clients on flash if they changed
#   housekeep      save, cap the log files, retry an empty gravity (cron)
#
# gravity.db lives in RAM (11 MB with Hagezi Pro, too big for the overlay).
# Groups, adlists, allow/deny domains and clients are kept on flash in
# /etc/pihole/lists.db (gravity rows stripped) and copied back at boot.

DIR=/tmp/pihole
DB=$DIR/gravity.db
SAVED=/etc/pihole/lists.db
SHARE=/usr/share/pihole
FTL=/usr/bin/pihole-FTL
DNSMASQ_PORT=5335
HAGEZI=https://raw.githubusercontent.com/hagezi/dns-blocklists/main/adblock
MARK='AlphaWRT preset'

sql() { $FTL sqlite3 -ni "$@"; }
own() { [ "$(id -u)" = 0 ] && chown pihole:pihole "$@"; return 0; }
enabled() { [ "$(uci -q get pihole.main.enabled)" = 1 ]; }
enforced() { enabled && [ "$(uci -q get pihole.main.enforce)" != 0 ]; }
# canaries answered NXDOMAIN: Firefox then skips its own DoH, Apple devices
# Private Relay; the rest are DoH servers browsers and apps can be set to
NOHOST='use-application-dns.net mask.icloud.com mask-h2.icloud.com dns.google dns.google.com
	cloudflare-dns.com mozilla.cloudflare-dns.com chrome.cloudflare-dns.com one.one.one.one
	dns.quad9.net dns9.quad9.net dns10.quad9.net doh.opendns.com doh.familyshield.opendns.com
	dns.adguard-dns.com dns.adguard.com unfiltered.adguard-dns.com family.adguard-dns.com
	doh.cleanbrowsing.org dns.nextdns.io doh.mullvad.net dns.mullvad.net'
count() { sql "$DB" "SELECT value FROM info WHERE property = 'gravity_count';" 2>/dev/null; }

# new_db <file> <old db>: empty schema plus the old db's groups, lists,
# domains and clients
new_db() {
	rm -f "$1"
	sql "$1" < $SHARE/gravity.db.sql >/dev/null || return 1
	[ -s "$2" ] || return 0
	sed "s#/etc/pihole/gravity.db#$2#" $SHARE/gravity_copy.sql | sql "$1" >/dev/null
}

prepare() {
	mkdir -p $DIR /etc/pihole
	touch $DIR/gravity.lock && chmod 666 $DIR/gravity.lock 2>/dev/null
	own $DIR /etc/pihole
	[ -s $DB ] && return 0
	new_db $DB $SAVED && own $DB
	sum > $DIR/saved.md5
}

sum() {
	sql $DB ".dump group domainlist adlist client domainlist_by_group adlist_by_group client_by_group" | md5sum
}

save() {
	[ -s $DB ] || return 0
	s=$(sum)
	[ "$s" = "$(cat $DIR/saved.md5 2>/dev/null)" ] && return 0
	rm -f $DIR/lists.tmp
	sql $DB "VACUUM INTO '$DIR/lists.tmp';" &&
	sql $DIR/lists.tmp "DELETE FROM gravity; DELETE FROM antigravity; VACUUM;" &&
	mv $DIR/lists.tmp $SAVED && own $SAVED && echo "$s" > $DIR/saved.md5
}

reloadlists() {
	pid=$(pidof pihole-FTL) && kill -"$($FTL sigrtmin)" $pid
}

gravity() {
	prepare
	exec 9>>$DIR/gravity.lock
	flock -n 9 || { echo "gravity is already being updated"; return 1; }
	old=$DB; [ -s $old ] || old=$SAVED
	new=$DB.new
	new_db $new $old || { echo "cannot create $new"; return 1; }
	att=; [ -s "$old" ] && att="ATTACH '$old' AS old;"
	sql $new "SELECT id, type, address FROM adlist WHERE enabled = 1 AND type IN (0, 1);" |
	while IFS='|' read -r id type url; do
		kind=gravity; [ "$type" = 1 ] && kind=antigravity
		echo "  $url"
		if uclient-fetch -q -T 60 -O $DIR/list.tmp "$url"; then
			sql $new "UPDATE adlist SET status = 1 WHERE id = $id;"
			$FTL $kind parseList $DIR/list.tmp $new $id "$url" | tail -n 1
		elif [ -n "$att" ]; then
			# DNS keeps blocking with what it had
			echo "    download failed, keeping the old entries"
			sql $new "$att INSERT INTO $kind SELECT * FROM old.$kind WHERE adlist_id = $id;
				UPDATE adlist SET status = 3 WHERE id = $id;"
		else
			echo "    download failed"
			sql $new "UPDATE adlist SET status = 4 WHERE id = $id;"
		fi
		rm -f $DIR/list.tmp
	done
	sql $new "CREATE INDEX idx_gravity ON gravity (domain, adlist_id);
		CREATE INDEX idx_antigravity ON antigravity (domain, adlist_id);
		INSERT OR REPLACE INTO info (property, value) VALUES
		('updated', cast(strftime('%s', 'now') as int)),
		('gravity_count', (SELECT count(DISTINCT domain) FROM gravity)),
		('antigravity_count', (SELECT count(DISTINCT domain) FROM antigravity)),
		('abp_domains', (SELECT EXISTS (SELECT 1 FROM gravity WHERE domain LIKE '||%')));" || return 1
	own $new
	mv $new $DB	# FTL reloads when the file is replaced
	save
	echo "  $(count) domains on the lists"
}

daily() { enabled && gravity; }

ensure() {
	enabled && [ "$(count)" -gt 0 ] 2>/dev/null && return 0
	enabled && gravity
}

housekeep() {
	enabled || return 0
	save
	# retry an empty gravity (the boot rebuild can fail before the clock syncs)
	[ "$(count)" -gt 0 ] 2>/dev/null || (ensure >/dev/null 2>&1 &)
	for f in $DIR/pihole.log $DIR/FTL.log $DIR/webserver.log; do
		[ "$(wc -c < $f 2>/dev/null)" -gt 1048576 ] 2>/dev/null && : > $f
	done
	return 0
}

# preset (light|multi|pro|pro.plus|ultimate) and TIF as Hagezi adlists;
# lists added in the Pi-hole admin are left alone. True if they changed.
sync_lists() {
	want="$(uci -q get pihole.main.preset)"
	[ "$(uci -q get pihole.main.tif)" = 1 ] && want="$want tif.mini"
	urls=; for p in $want; do urls="$urls,'$HAGEZI/$p.txt'"; done
	urls=${urls#,}
	before=$(sql $DB "SELECT group_concat(address) FROM adlist WHERE comment = '$MARK';")
	sql $DB "DELETE FROM gravity WHERE adlist_id IN (SELECT id FROM adlist WHERE comment = '$MARK' AND address NOT IN ($urls));
		DELETE FROM adlist WHERE comment = '$MARK' AND address NOT IN ($urls);"
	for p in $want; do
		sql $DB "INSERT OR IGNORE INTO adlist (address, comment) VALUES ('$HAGEZI/$p.txt', '$MARK');"
	done
	[ "$before" != "$(sql $DB "SELECT group_concat(address) FROM adlist WHERE comment = '$MARK';")" ]
}

# dnsmasq keeps DHCP and the .lan names on $DNSMASQ_PORT while FTL has :53.
# Off port 53, dnsmasq stops naming itself as DNS in its leases, so every pool
# (LAN and guest, issues/0024) hands out 6,0.0.0.0 (0.0.0.0 = this box).
dnsmasq_port() {
	local s
	if [ "$(uci -q get dhcp.@dnsmasq[0].port)" != "$1" ]; then
		if [ -n "$1" ]; then
			uci set dhcp.@dnsmasq[0].port="$1"
		else
			uci delete dhcp.@dnsmasq[0].port
		fi
	fi
	for s in lan guest; do
		uci -q get dhcp.$s >/dev/null || continue
		if uci -q get dhcp.$s.dhcp_option | tr ' ' '\n' | grep -qx '6,0.0.0.0'; then
			[ -n "$1" ] || uci del_list dhcp.$s.dhcp_option='6,0.0.0.0'
		else
			[ -z "$1" ] || uci add_list dhcp.$s.dhcp_option='6,0.0.0.0'
		fi
	done
	[ -n "$(uci changes dhcp)" ] || return 0
	uci commit dhcp
	/etc/init.d/dnsmasq restart
}

ftl_config() {
	eval "$(ipcalc.sh "$(uci -q get network.lan.ipaddr)" $(uci -q get network.lan.netmask))"
	# bridge mode: the clients sit on the main router's network, not ours
	listen=LOCAL
	uci -q get network.ontbridge >/dev/null && listen=ALL
	# device names: our LAN from our dnsmasq, plus any revserver from uci
	# ("true,192.168.0.0/24,192.168.100.2#5354,am": the main router's leases)
	rev="\"true,$NETWORK/$PREFIX,127.0.0.1#$DNSMASQ_PORT,lan\""
	for r in $(uci -q get pihole.main.revserver); do rev="$rev,\"$r\""; done
	set -- \
		dns.listeningMode $listen \
		dns.upstreams "[\"127.0.0.1#$DNSMASQ_PORT\"]" \
		dns.revServers "[$rev]" \
		dhcp.active false \
		ntp.ipv4.active false ntp.ipv6.active false ntp.sync.active false \
		webserver.port '8080o,[::]:8080o' \
		webserver.paths.webroot /usr/share/pihole/www \
		files.gravity $DB \
		files.database $DIR/pihole-FTL.db \
		files.macvendor $DIR/macvendor.db \
		files.log.ftl $DIR/FTL.log \
		files.log.webserver $DIR/webserver.log \
		files.log.dnsmasq $DIR/pihole.log \
		database.maxDBdays 2 \
		misc.dnsmasq_lines "$(nohost_lines)"
	while [ $# -gt 1 ]; do
		$FTL --config "$1" "$2" >/dev/null || echo "FTL refused $1 = $2"
		shift 2
	done
	own /etc/pihole/pihole.toml
}

nohost_lines() {
	enforced || { echo '[]'; return; }
	l=; for d in $NOHOST; do l="$l,\"address=/$d/\""; done
	echo "[${l#,}]"
}

# Clients with their own DNS go through Pi-hole too: LAN port 53 is sent to
# this box and DNS over TLS (853) out of the LAN is refused. Encrypted DNS to
# a hard-coded address, or a VPN, still goes around it.
enforce() {
	if enforced; then
		uci -q batch <<-EOF
		set firewall.pihole_dns=redirect
		set firewall.pihole_dns.name='Pi-hole: LAN DNS to this box'
		set firewall.pihole_dns.src=lan
		set firewall.pihole_dns.src_dport=53
		set firewall.pihole_dns.proto='tcp udp'
		set firewall.pihole_dns.target=DNAT
		set firewall.pihole_dns.family=any
		set firewall.pihole_dot=rule
		set firewall.pihole_dot.name='Pi-hole: no DNS over TLS'
		set firewall.pihole_dot.src=lan
		set firewall.pihole_dot.dest='*'
		set firewall.pihole_dot.dest_port=853
		set firewall.pihole_dot.proto='tcp udp'
		set firewall.pihole_dot.target=REJECT
		EOF
	else
		uci -q delete firewall.pihole_dns
		uci -q delete firewall.pihole_dot
	fi
	[ -n "$(uci changes firewall)" ] || return 0
	uci commit firewall
	/etc/init.d/firewall reload >/dev/null 2>&1
}

apply() {
	/etc/init.d/pihole-FTL stop
	if enabled; then
		dnsmasq_port $DNSMASQ_PORT
		prepare
		ftl_config
		changed=0; sync_lists && changed=1
		/etc/init.d/pihole-FTL enable
		/etc/init.d/pihole-FTL start
		save
		if [ $changed = 1 ]; then (gravity >/dev/null 2>&1 &); else (ensure >/dev/null 2>&1 &); fi
	else
		/etc/init.d/pihole-FTL disable
		dnsmasq_port ''
	fi
	enforce
}

case "$1" in
	-g|updateGravity) gravity ;;
	ensure|daily|reloadlists|apply|prepare|save|housekeep) "$1" ;;
	restartdns|reloaddns) /etc/init.d/pihole-FTL restart ;;
	-v|version) $FTL --version ;;
	*) echo "usage: pihole -g|ensure|daily|reloadlists|restartdns|apply|save|housekeep|version"; exit 1 ;;
esac
