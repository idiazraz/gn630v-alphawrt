#!/bin/sh /etc/rc.common
# Pi-hole FTL. Off unless pihole.main.enabled=1; turn it on and off with
# `pihole apply` (it also moves dnsmasq off port 53).

START=19
USE_PROCD=1

start_service() {
	[ "$(uci -q get pihole.main.enabled)" = 1 ] || return 0
	/usr/local/bin/pihole prepare
	procd_open_instance
	procd_set_param command /usr/bin/pihole-FTL -f
	procd_set_param user pihole
	procd_set_param group pihole
	procd_set_param capabilities /etc/capabilities/pihole-FTL.json
	# procd hands capabilities only to ujail; with no mounts it makes no
	# filesystem jail, just drops to the pihole user keeping them (port 53)
	procd_add_jail pihole-FTL
	procd_set_param respawn
	procd_close_instance
}

stop_service() {
	/usr/local/bin/pihole save
}
