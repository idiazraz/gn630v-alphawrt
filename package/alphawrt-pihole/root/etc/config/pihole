config pihole 'main'
	option enabled '0'
	# Hagezi preset: light, multi (Normal), pro, pro.plus, ultimate
	option preset 'multi'
	# also block Hagezi's threat intelligence feed (tif.mini)
	option tif '0'
	# while on, LAN devices with their own plain DNS go through Pi-hole too
	# (port 53 sent here; browsers told to drop their own DoH)
	option enforce '1'
	# also refuse DNS over TLS/QUIC and block the known DoH servers; devices
	# set to strict encrypted DNS (e.g. Android Private DNS) lose DNS
	option strict '0'
	# bridge mode: ask the main router for device names, e.g.
	# list revserver 'true,192.168.0.0/24,192.168.100.2#5354,am'
