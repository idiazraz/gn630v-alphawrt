#!/bin/sh
# Pi-hole's DoT refusal and DoH server blocks are now opt-in
# (pihole.main.strict). Earlier builds had them on
# whenever Pi-hole was: rewrite FTL's settings and the firewall rules from uci.
[ "$(uci -q get pihole.main.strict)" = 1 ] && exit 0
/usr/local/bin/pihole sync >/dev/null 2>&1
exit 0
