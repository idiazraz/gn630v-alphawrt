#!/bin/sh
# rpcd backend for the AlphaWRT Quick Setup.
#   presets         ISP and ONT-model presets (/usr/share/alphawrt/*.json)
#   stock_identity  the GPON identity the stock firmware saved in its
#                   "romfile" (gzip XML), so a unit the ISP registered keeps it
#   banks           what each flash bank holds, which one runs and which one
#                   U-Boot boots next (alphawrt-bootbank)
#   set_bank        {"bank": "a"|"b"}: boot that bank from the next boot

. /lib/functions.sh
. /usr/share/libubox/jshn.sh

# gpon_attr <element> <attribute>: value of <GPON><element .../> in the
# stock config
gpon_attr() {
	awk -v el="<$1 " -v at=" $2=\"" '
		index($0, "<GPON>") { f = 1 }
		index($0, "</GPON>") { f = 0 }
		f && index($0, el) && (i = index($0, at)) {
			v = substr($0, i + length(at)); print substr(v, 1, index(v, "\"") - 1); exit
		}' "$XML" | sed -e 's/&lt;/</g' -e 's/&gt;/>/g' -e 's/&quot;/"/g' \
		-e "s/&apos;/'/g" -e 's/&amp;/\&/g'
}

stock_identity() {
	local mtdnum serial omcc sw0 sw1

	json_init
	mtdnum=$(find_mtd_index romfile)
	XML=/tmp/alphawrt-romfile.xml
	if [ -n "$mtdnum" ] && zcat "/dev/mtd$mtdnum" > "$XML" 2>/dev/null; then
		serial=$(gpon_attr ONU SerialNumber)
		json_add_string serial "$serial"
		json_add_string password "$(gpon_attr ONU Password)"
		# the OLT registered the serial, whose first four characters are the
		# vendor ID: stock's separate OMCI vendor ID would overwrite them
		json_add_string vendor_id "$(echo "$serial" | cut -c1-4)"
		json_add_string equipment_id "$(gpon_attr ONU EquipmentId)"
		json_add_string hardware_version "$(gpon_attr ONU Version)"
		# installing AlphaWRT from the stock web UI records "AlphaWRT" as that
		# slot's version: report the stock version for both slots instead
		sw0=$(gpon_attr SoftImage0 Version)
		sw1=$(gpon_attr SoftImage1 Version)
		case "$sw0" in AlphaWRT*) sw0=$sw1 ;; esac
		case "$sw1" in AlphaWRT*) sw1=$sw0 ;; esac
		json_add_string software_version_0 "$sw0"
		json_add_string software_version_1 "$sw1"
		# stock keeps it in hex ("A0"), the OMCI agent takes decimal
		omcc=$(gpon_attr ONU OMCCVersion)
		case "$omcc" in
		[0-9A-Fa-f][0-9A-Fa-f]) omcc=$(printf %d "0x$omcc") ;;
		*) omcc= ;;
		esac
		json_add_string omcc_version "$omcc"
	else
		json_add_string error "no stock configuration found"
	fi
	rm -f "$XML"
	json_dump
}

banks() {
	local out

	out=$(alphawrt-bootbank 2>&1)
	json_init
	json_add_string running "$(echo "$out" | sed -n 's/^running: *bank \([ab]\).*/\1/p')"
	json_add_string next "$(echo "$out" | sed -n 's/^next boot: *bank \([ab]\).*/\1/p')"
	json_add_string a "$(echo "$out" | sed -n 's/^bank a: *//p')"
	json_add_string b "$(echo "$out" | sed -n 's/^bank b: *//p')"
	json_dump
}

set_bank() {
	local bank out

	read -r input
	json_load "$input"
	json_get_var bank bank
	json_init
	case "$bank" in
	a|b)
		if out=$(alphawrt-bootbank "$bank" 2>&1); then
			json_add_boolean ok 1
		else
			json_add_boolean ok 0
		fi
		json_add_string message "$out"
		;;
	*)
		json_add_boolean ok 0
		json_add_string message "bank must be a or b"
		;;
	esac
	json_dump
}

case "$1" in
list)
	echo '{ "presets": {}, "stock_identity": {}, "banks": {}, "set_bank": { "bank": "a" } }'
	;;
call)
	case "$2" in
	presets)
		printf '{ "presets": %s, "onts": %s }\n' \
			"$(cat /usr/share/alphawrt/isp.json)" "$(cat /usr/share/alphawrt/ont.json)"
		;;
	stock_identity)
		stock_identity
		;;
	banks)
		banks
		;;
	set_bank)
		set_bank
		;;
	esac
	;;
esac
