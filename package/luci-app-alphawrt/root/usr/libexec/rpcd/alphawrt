#!/bin/sh
# rpcd backend for the AlphaWRT Quick Setup.
#   presets         ISP and ONT-model presets (/usr/share/alphawrt/*.json)
#   stock_identity  the GPON identity the stock firmware saved in its
#                   "romfile" (gzip XML), so a unit the ISP registered keeps it
#   banks           what each flash bank holds, which one runs and which one
#                   U-Boot boots next (alphawrt-bootbank)
#   set_bank        {"bank": "a"|"b"}: boot that bank from the next boot
#   wan_mode        what the PON SerDes carries, on boards that can switch it
#   set_wan_mode    {"mode": "fibre"|"ethernet"}: from the next boot
#   pon_info        registration state, the Internet VLAN the OLT provisioned,
#                   if it can be read from the MIB, and where the GPON serial
#                   came from (never the serial itself: pages poll this)
#   set_identity    {serial, password, ...}: write and apply the GPON
#                   identity at once (before the fibre goes in)
#   line            line counters, the OLT's SD/SF and light thresholds,
#                   24 h history and events (alphawrt-linemon)
#   cpu             {"cpu": [[busy, total], ...]} in jiffies from /proc/stat:
#                   index 0 all cores, then one per core; busy = total - idle
#                   - iowait. Callers diff two samples. Shared with the Simple UI.

. /lib/functions.sh
. /usr/share/libubox/jshn.sh

# gpon_attr <element> <attribute>: value of <GPON><element .../> in the
# stock config
gpon_attr() {
	awk -v el="<$1 " -v at=" $2=\"" '
		index($0, "<GPON>") { f = 1 }
		index($0, "</GPON>") { f = 0 }
		f && index($0, el) && (i = index($0, at)) {
			v = substr($0, i + length(at)); print substr(v, 1, index(v, "\"") - 1); exit
		}' "$XML" | sed -e 's/&lt;/</g' -e 's/&gt;/>/g' -e 's/&quot;/"/g' \
		-e "s/&apos;/'/g" -e 's/&amp;/\&/g'
}

stock_identity() {
	local mtdnum serial omcc sw0 sw1

	json_init
	mtdnum=$(find_mtd_index romfile)
	XML=/tmp/alphawrt-romfile.xml
	if [ -n "$mtdnum" ] && zcat "/dev/mtd$mtdnum" > "$XML" 2>/dev/null; then
		serial=$(gpon_attr ONU SerialNumber)
		json_add_string serial "$serial"
		json_add_string password "$(gpon_attr ONU Password)"
		# Note: this is a GN630V, and TM-supplied GN630Vs send these in OMCI
		# whatever the romfile says (its VendorId SKYW, EquipmentId PT632,
		# Version RP0201 and OMCCVersion A0 are not what goes on the wire):
		# vendor CWTC, model GN630V, hardware CW1.0, OMCC 150. TM's Nokia OLT
		# provisions nothing when they differ. The serial is the box's own.
		json_add_string vendor_id CWTC
		json_add_string equipment_id GN630V
		json_add_string hardware_version CW1.0
		# installing AlphaWRT from the stock web UI records "AlphaWRT" as that
		# slot's version: report the stock version for both slots instead
		sw0=$(gpon_attr SoftImage0 Version)
		sw1=$(gpon_attr SoftImage1 Version)
		case "$sw0" in AlphaWRT*) sw0=$sw1 ;; esac
		case "$sw1" in AlphaWRT*) sw1=$sw0 ;; esac
		json_add_string software_version_0 "$sw0"
		json_add_string software_version_1 "$sw1"
		omcc=150
		json_add_string omcc_version "$omcc"
	else
		json_add_string error "no stock configuration found"
	fi
	rm -f "$XML"
	json_dump
}

banks() {
	local out

	out=$(alphawrt-bootbank 2>&1)
	json_init
	json_add_string running "$(echo "$out" | sed -n 's/^running: *bank \([ab]\).*/\1/p')"
	json_add_string next "$(echo "$out" | sed -n 's/^next boot: *bank \([ab]\).*/\1/p')"
	json_add_string a "$(echo "$out" | sed -n 's/^bank a: *//p')"
	json_add_string b "$(echo "$out" | sed -n 's/^bank b: *//p')"
	json_dump
}

set_bank() {
	local bank out

	read -r input
	json_load "$input"
	json_get_var bank bank
	json_init
	case "$bank" in
	a|b)
		if out=$(alphawrt-bootbank "$bank" 2>&1); then
			json_add_boolean ok 1
		else
			json_add_boolean ok 0
		fi
		json_add_string message "$out"
		;;
	*)
		json_add_boolean ok 0
		json_add_string message "bank must be a or b"
		;;
	esac
	json_dump
}

wan_mode() {
	json_init
	if [ -x /sbin/alphawrt-wan-mode ]; then
		json_add_boolean supported 1
		json_add_string mode "$(alphawrt-wan-mode)"
	else
		json_add_boolean supported 0
	fi
	json_dump
}

set_wan_mode() {
	local mode out

	read -r input
	json_load "$input"
	json_get_var mode mode
	json_init
	if [ -x /sbin/alphawrt-wan-mode ] && out=$(alphawrt-wan-mode "$mode" 2>&1); then
		json_add_boolean ok 1
	else
		json_add_boolean ok 0
	fi
	json_add_string message "$out"
	json_dump
}

pon_info() {
	local data vid source

	json_init
	json_add_int state "$(ubus call omci.agent status '{"device":0}' 2>/dev/null | jsonfilter -e @.status.state)"
	# enum omci_config_source: below 5 (netlink) nobody set the serial
	source=$(ubus call omci.agent config_get '{"device":0,"key":"serial"}' 2>/dev/null |
		jsonfilter -e @.config.source)
	[ -n "$source" ] && json_add_int serial_source "$source"
	# ME 78 (VLAN tagging operation) on Ethernet UNI 1 (entity 0x0101): the
	# tag the OLT adds upstream on the first LAN port is the ISP's Internet
	# VLAN (TIME's Huawei OLTs provision it this way). Bytes 1-2 are the TCI.
	data=$(ubus call omci.agent mib_get '{"device":0,"class_id":78,"entity_id":257}' 2>/dev/null |
		jsonfilter -e @.object.data)
	if [ ${#data} -ge 8 ]; then
		vid=$(( 0x$(echo "$data" | cut -c3-6) & 0xfff ))
		# VLAN 1 is the default the OLT gives unused ports
		[ "$vid" -gt 1 ] && [ "$vid" -lt 4095 ] && json_add_int vlan "$vid"
	fi
	json_dump
}

set_identity() {
	local k v serial conf=omci

	# each agent reads its own file: omci-agent omci, xpon-agent xpon
	[ -f /etc/config/xpon ] && conf=xpon
	read -r input
	json_load "$input"
	for k in serial password equipment_id hardware_version software_version_0 \
		software_version_1 omcc_version traffic_management_option olt_profile; do
		json_get_var v "$k"
		uci -q set "$conf.main.$k=$v"
	done
	json_get_var serial serial
	# the vendor ID is the serial's own first four characters
	uci -q set "$conf.main.vendor_id=$(echo "$serial" | cut -c1-4)"
	uci -q set "$conf.main.enabled=1"
	uci commit "$conf"
	ubus call omci.agent apply '{"device":0}' >/dev/null 2>&1
	json_init
	json_add_boolean ok 1
	json_dump
}

# file -> JSON array of its lines
json_lines() {
	[ -f "$1" ] && awk '{ gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); printf "%s\"%s\"", (NR > 1 ? "," : ""), $0 }' "$1"
}

line() {
	printf '{ "counters": "%s", "thresholds": "%s", "history": [ %s ], "events": [ %s ] }\n' \
		"$(tr '\n' ' ' < /sys/bus/platform/devices/1fb60000.xmac/gpon_counters 2>/dev/null)" \
		"$(cat /tmp/alphawrt/thresholds 2>/dev/null)" \
		"$(json_lines /tmp/alphawrt/line.hist)" "$(json_lines /tmp/alphawrt/events.log)"
}

cpu() {
	awk '/^cpu/ { t = 0; for (i = 2; i <= NF; i++) t += $i
		printf "%s[%d,%d]", (n++ ? "," : "{ \"cpu\": ["), t - $5 - $6, t }
		END { print "] }" }' /proc/stat
}

case "$1" in
list)
	echo '{ "presets": {}, "stock_identity": {}, "banks": {}, "set_bank": { "bank": "a" }, "wan_mode": {}, "set_wan_mode": { "mode": "fibre" }, "pon_info": {}, "line": {}, "cpu": {},
		"set_identity": { "serial": "", "password": "", "equipment_id": "", "hardware_version": "",
			"software_version_0": "", "software_version_1": "", "omcc_version": "",
			"traffic_management_option": "", "olt_profile": "" } }'
	;;
call)
	case "$2" in
	presets)
		printf '{ "presets": %s, "onts": %s }\n' \
			"$(cat /usr/share/alphawrt/isp.json)" "$(cat /usr/share/alphawrt/ont.json)"
		;;
	stock_identity)
		stock_identity
		;;
	banks)
		banks
		;;
	set_bank)
		set_bank
		;;
	pon_info|set_identity|line|cpu|wan_mode|set_wan_mode)
		$2
		;;
	esac
	;;
esac
