#!/bin/sh /etc/rc.common
# iperf3 server for LAN and Wi-Fi tests: runs only while
# alphawrt.homelab.iperf3=1 (Simple UI Home lab page). fw4 keeps it off wan.

START=95
USE_PROCD=1

start_service() {
	[ "$(uci -q get alphawrt.homelab.iperf3)" = 1 ] || return 0
	[ -x /usr/bin/iperf3 ] || return 0
	procd_open_instance
	procd_set_param command /usr/bin/iperf3 -s
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger alphawrt
}
