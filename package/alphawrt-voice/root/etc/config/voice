# Phone line on the TEL port, set from the Simple UI's Phone page.
# preset: unifi or custom. user is the phone number; auth_user only when the
# provider gives a separate login. vlan: the provider's voice VLAN on the
# fibre, empty to use the internet connection; vlan_prio its 802.1p priority
# (the Phone page writes it into network.voice_vlan). useragent: the SIP User-Agent,
# empty for baresip's own (Maxis needs one of its routers').
config voice 'main'
	option enabled '0'
	option preset 'custom'
	option registrar ''
	option proxy ''
	option user ''
	option auth_user ''
	option password ''
	option display ''
	option transport 'udp'
	option codecs 'PCMA PCMU'
	option vlan ''
	option vlan_prio ''
	option useragent ''
